{
  "components/themevale/homepage/component/recent-post-list-2": "<div class=\"themevale_section themevale_blogs_custom\" id=\"themevale_blogs\">\r\n    <div class=\"container\">\r\n        <div class=\"themevale_page-heading-wrapper\">\r\n            <h2 class=\"page-heading text-left\">From Our Blog</h2>\r\n            <!--<a href=\"/blog/\" class=\"themevale_link custom\">View More</a>-->\r\n        </div>\r\n        {{#if blog.recent_posts}}\r\n            <div class=\"themevale_blog_custom\">\r\n                {{#each blog.recent_posts}}\r\n                    {{#if @first}}\r\n                        <div class=\"items\">\r\n                            {{> components/blog/recent_post-2 post=this settings=../settings}}\r\n                        </div>\r\n                    {{/if}}\r\n                {{/each}}\r\n                <div class=\"items\">\r\n                    {{#each blog.recent_posts}}\r\n                        {{#if @index '!=' 0}}\r\n                            <div class=\"item\">\r\n                                {{> components/blog/recent_post-3 post=this settings=../settings}}\r\n                            </div>\r\n                        {{/if}}\r\n                    {{/each}}\r\n                </div>\r\n            </div>\r\n        {{/if}}\r\n        {{{region name=\"below_recent_post_list\"}}}\r\n    </div>\r\n</div>\r\n",
  "components/blog/recent_post-3": "<article class=\"blog recent-post layout-2\">\r\n    <div class=\"blog-post-figure\">\r\n        {{#if post.thumbnail}}\r\n            <figure class=\"blog-thumbnail\">\r\n                <a href=\"{{post.url}}\">\r\n                    <img src=\"{{getImage post.thumbnail 'recent_post_size'}}\" alt=\"{{post.thumbnail.alt}}\" title=\"{{post.thumbnail.alt}}\">\r\n                </a>\r\n            </figure>\r\n        {{/if}}\r\n    </div>\r\n    <div class=\"blog-post-body\">\r\n        <div class=\"blog-header\">\r\n            <h2 class=\"blog-title\">\r\n                <a href=\"{{post.url}}\">{{post.title}}</a>\r\n            </h2>\r\n            <p class=\"blog-date\">{{#if post.author}}{{lang 'blog.posted_by' name=post.author}} on {{/if}}{{post.date_published}}</p>\r\n        </div>\r\n        <div class=\"blog-post\">\r\n            {{{post.summary}}}\r\n            {{#if post.show_read_more}}\r\n                &hellip;\r\n                <a href=\"{{url}}\">read more</a>\r\n            {{/if}}\r\n        </div>\r\n    </div>\r\n</article>\r\n",
  "components/blog/recent_post-2": "<article class=\"blog recent-post post-first\">\r\n    <div class=\"blog-post-figure\">\r\n        {{#if post.thumbnail}}\r\n            <figure class=\"blog-thumbnail\">\r\n                <a href=\"{{post.url}}\">\r\n                    <img src=\"{{getImage post.thumbnail 'recent_post_size'}}\" alt=\"{{post.thumbnail.alt}}\" title=\"{{post.thumbnail.alt}}\">\r\n                </a>\r\n            </figure>\r\n        {{/if}}\r\n    </div>\r\n    <div class=\"blog-post-body\">\r\n        <div class=\"blog-header\">\r\n            <h2 class=\"blog-title\">\r\n                <a href=\"{{post.url}}\">{{post.title}}</a>\r\n            </h2>\r\n            <p class=\"blog-date\">{{#if post.author}}{{lang 'blog.posted_by' name=post.author}} on {{/if}}{{post.date_published}}</p>\r\n        </div>\r\n        <div class=\"blog-post\">\r\n            {{{post.summary}}}\r\n            {{#if post.show_read_more}}\r\n                &hellip;\r\n                <a href=\"{{url}}\">read more</a>\r\n            {{/if}}\r\n        </div>\r\n    </div>\r\n</article>\r\n"
}
