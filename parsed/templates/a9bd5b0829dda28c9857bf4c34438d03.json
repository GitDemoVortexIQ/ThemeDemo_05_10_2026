{"components/cavio/description-accordion":"<div class=\"accordion-contents\">\r\n    {{#if product.description}}\r\n    <div class=\"productDetailsView-section product-description show-descp\">\r\n        <p class=\"productView-title\">{{lang 'products.description'}}\r\n            <svg class=\"expand-icon icon\"><use xlink:href=\"#icon-cavio_expand-down\" /></svg>\r\n        </p>\r\n        \r\n        <div class=\"tab-content\" id=\"tab-description\">\r\n            {{{product.description}}}\r\n        </div>\r\n    </div>\r\n    {{/if}}\r\n    {{#if product.warranty}}\r\n    <div class=\"productDetailsView-section product-warrnaty\">\r\n        <p class=\"productView-title\">{{lang 'products.warranty'}}\r\n            <svg class=\"expand-icon icon\"><use xlink:href=\"#icon-cavio_expand-down\" /></svg>            \r\n        </p>\r\n        <div class=\"tab-content\">\r\n            {{{product.warranty}}}\r\n        </div>\r\n    </div>\r\n    {{/if}}\r\n    {{#all product.custom_fields theme_settings.show_custom_fields_tabs}}\r\n        <div class=\"productDetailsView-section product-custom-fields\">\r\n            <p class=\"productView-title\">{{sanitize theme_settings.pdp-custom-fields-tab-label}}\r\n                <svg class=\"expand-icon icon\"><use xlink:href=\"#icon-cavio_expand-down\" /></svg>                \r\n            </p>\r\n              <div class=\"tab-content\">\r\n                 <dl class=\"productView-info\">\r\n                    {{> components/products/custom-fields }}\r\n                 </dl>\r\n              </div>\r\n          </div>\r\n    {{/all}}\r\n\r\n    {{#if product.videos.list.length}}\r\n    <div class=\"productDetailsView-section product-videos\">\r\n        <p class=\"productView-title\">{{lang 'products.prdt_video'}}\r\n            <svg class=\"expand-icon icon\"><use xlink:href=\"#icon-cavio_expand-down\" /></svg>\r\n        </p>\r\n        \r\n        <div class=\"tab-content\" id=\"tab-videos\">\r\n            {{> components/products/videos product.videos}}\r\n        </div>\r\n    </div>\r\n    {{/if}}\r\n\r\n    {{#all settings.show_product_reviews theme_settings.show_product_reviews}}\r\n        {{#if product.reviews.total}}\r\n            <div class=\"productDetailsView-section product-reviews\">\r\n                <p class=\"productView-title\">{{lang 'products.reviews.header_title'}}\r\n                    <svg class=\"expand-icon icon\"><use xlink:href=\"#icon-cavio_expand-down\" /></svg>                \r\n                </p>\r\n               <div class=\"tab-content\">\r\n                   {{> components/products/reviews reviews=product.reviews product=product urls=urls}}\r\n               </div>\r\n           </div>\r\n       {{/if}}\r\n    {{/all}}\r\n    <div class=\"productDetailsView-section product-shipping\">\r\n        <p class=\"productView-title\"><a href=\"/shipping-returns\" aria-label=\"Shipping & Returns\">Shipping & Returns</a></p>\r\n    </div>\r\n</div>\r\n","components/common/paginator":"<nav class=\"pagination\" aria-label=\"pagination\">\n    <ul class=\"pagination-list\">\n        {{#if previous}}\n            <li class=\"pagination-item pagination-item--previous\">\n                <a class=\"pagination-link\"\n                   href=\"{{previous}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   aria-label=\"{{lang 'common.previous'}}\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\">\n                        <svg>\n                            <use href=\"#icon-chevron-left\"></use>\n                        </svg>\n                    </i>\n                    {{lang 'common.previous'}}\n                </a>\n            </li>\n        {{/if}}\n        {{#each links}}\n            <li class=\"pagination-item {{#if this.number '==' ../current}}pagination-item--current{{/if}}\">\n                <a class=\"pagination-link\"\n                   href=\"{{this.url}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   {{#if this.number '==' ../current}}\n                   aria-current=\"page\"\n                   data-pagination-current-page-link\n                   {{/if}}\n                   aria-label=\"{{lang 'common.paginator.page_of' current=this.number total=../links.length}}\"\n                >\n                    {{this.number}}\n                </a>\n            </li>\n        {{/each}}\n\n        {{#if next}}\n            <li class=\"pagination-item pagination-item--next\">\n                <a class=\"pagination-link\"\n                   href=\"{{next}}\"\n                   {{#unless reload}}data-faceted-search-facet{{/unless}}\n                   aria-label=\"{{lang 'common.next'}}\"\n                >\n                    {{lang 'common.next'}}\n                    <i class=\"icon\" aria-hidden=\"true\">\n                        <svg>\n                            <use href=\"#icon-chevron-right\"></use>\n                        </svg>\n                    </i>\n                </a>\n            </li>\n        {{/if}}\n    </ul>\n</nav>\n","components/products/custom-fields":"{{#each product.custom_fields}}\n\t{{#if (toLowerCase name) '==' 'size'}}\n\t{{else}}\n\t\t<dt class=\"productView-info-name\">{{name}}:</dt>\n\t\t<dd class=\"productView-info-value\">{{{value}}}</dd>\n\t{{/if}}\n{{/each}}\n","components/products/ratings":"<span role=\"img\"\n    {{#if rating_target}}\n      aria-label=\"{{lang 'products.reviews.rating_aria_label' rating_target=rating_target current_rating=rating max_rating=5}}\"\n    {{else}}\n      aria-label=\"{{lang 'products.reviews.rating_aria_label' rating_target='Product' current_rating=rating max_rating=5}}\"\n    {{/if}}\n>\n    {{#for 1 5}}\n        {{#if ../this.rating '>=' $index}}\n            <span class=\"icon icon--ratingFull\">\n                <svg>\n                    <use href=\"#icon-cavio_rating\" />\n                </svg>\n            </span>\n        {{else}}\n            <span class=\"icon icon--ratingEmpty\">\n                <svg>\n                    <use href=\"#icon-cavio_rating\" />\n                </svg>\n            </span>\n        {{/if}}\n    {{/for}}\n</span>\n","components/products/reviews":"{{#if reviews.total}}\n<section class=\"toggle productReviews\" id=\"product-reviews\" data-product-reviews>\n    <h4 class=\"toggle-title\">\n        {{lang 'products.reviews.header' total=reviews.total}}\n    </h4>\n    <div class=\"toggle-content is-open\" id=\"productReviews-content\" aria-hidden=\"false\">\n        <ul class=\"productReviews-list\" id=\"productReviews-list\">\n            {{#each reviews.list}}\n            <li class=\"productReview\">\n                <article>\n                    <header>\n                        <span class=\"productReview-rating rating--small\">\n                            {{> components/products/ratings rating=rating}}\n                            <span class=\"productReview-ratingNumber\">{{ rating }}</span>\n                        </span>\n                        <h5 class=\"productReview-title\">{{{ sanitize title }}}</h5>\n                        {{#if name}}\n                            <p class=\"productReview-author\">\n                                {{{lang 'products.reviews.post_on_by' date=date name=(sanitize name) }}}\n                            </p>\n                        {{else}}\n                            <p class=\"productReview-author\">\n                                {{lang 'products.reviews.post_on_by' date=date name=(lang 'products.reviews.anonymous_poster')}}\n                            </p>\n                        {{/if}}\n                    </header>\n                    <p class=\"productReview-body\">{{{ sanitize text }}}</p>\n                </article>\n            </li>\n            {{/each}}\n        </ul>\n        {{> components/common/paginator pagination.reviews reload=true}}\n    </div>\n</section>\n{{/if}}\n","components/products/videos":"<section class=\"toggle videoGallery\" data-video-gallery>\n    <h4 class=\"toggle-title\">\n        {{lang 'products.videos.header'}}\n        <a href=\"#videoGallery-content\" class=\"toggleLink is-open\" data-collapsible>\n            <span class=\"toggleLink-text toggleLink-text--on\">\n                {{lang 'products.videos.hide'}}\n            </span>\n            <span class=\"toggleLink-text toggleLink-text--off\">\n                {{lang 'products.videos.show'}}\n            </span>\n        </a>\n    </h4>\n\n    <div class=\"toggle-content is-open\" id=\"videoGallery-content\">\n        <div class=\"videoGallery-main widescreen\">\n            <iframe\n                id=\"player\"\n                class=\"lazyload\"\n                type=\"text/html\"\n                width=\"640\"\n                height=\"390\"\n                frameborder=\"0\"\n                webkitAllowFullScreen\n                mozallowfullscreen\n                allowFullScreen\n                data-src=\"//www.youtube.com/embed/{{this.featured.id}}?rel=0\"\n                data-video-player>\n            </iframe>\n        </div>\n        <ul class=\"videoGallery-list\">\n        {{#each this.list}}\n            <li class=\"videoGallery-item\">\n                <a href=\"#\" class=\"video {{#if @first}}is-active{{/if}}\" data-video-item data-video-id=\"{{id}}\">\n                    <div class=\"video-figure\">\n                        <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"//i.ytimg.com/vi/{{id}}/default.jpg\"/>\n                    </div>\n                    <div class=\"video-body\">\n                        <h5 class=\"video-title\">{{title_long}}</h5>\n                        <p class=\"video-description\">{{description_short}}</p>\n                    </div>\n                </a>\n            </li>\n        {{/each}}\n        </ul>\n    </div>\n\n</section>\n"}
