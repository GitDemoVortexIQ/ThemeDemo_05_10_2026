{
  "components/products/filter": "<div class=\"view-as-group actionBar\">\n    <label class=\"form-label\">{{lang 'common.view.view_as'}}</label>\n    <div class=\"view-as-btn\">\n        <a href=\"javascript:void(0);\" id=\"list-view\" data-layout=\"productGrid--maxCol1\" title=\"List View\">\n            <svg class=\"icon-view\"><use xlink:href=\"#icon-list\"></use></svg></a>\n        <a href=\"javascript:void(0);\" id=\"grid-view\" data-layout=\"productGrid--maxCol3\" title=\"Grid View 3\">\n            <svg class=\"icon-view\"><use xlink:href=\"#icon-list\"></use></svg></a>\n        <a href=\"javascript:void(0);\" id=\"grid-view-4\" data-layout=\"productGrid--maxCol4\" title=\"Grid View 4\">\n            <svg class=\"icon-view\"><use xlink:href=\"#icon-grid\"></use></svg></a>\n    </div>\n</div>\n<form class=\"actionBar\" method=\"get\" data-sort-by data-show-products>\n    {{> components/category/show-products limit=limit}}\n</form>\n<form class=\"actionBar\" method=\"get\" data-sort-by>\n    {{> components/category/sort-box sort=sort}}\n</form>\n",
  "components/category/sort-box": "<fieldset class=\"form-fieldset actionBar-section\">\r\n    <div class=\"form-field\"><label class=\"form-label\" for=\"sort\">{{lang 'common.sorter.sort_by'}}</label>\r\n        <select class=\"form-select\" name=\"sort\" id=\"sort\">\r\n            <option value=\"featured\" {{#if sort '==' 'featured'}}selected{{/if}}>{{lang 'common.sorter.featured'}}</option>\r\n            <option value=\"newest\" {{#if sort '==' 'newest'}}selected{{/if}}>{{lang 'common.sorter.newest'}}</option>\r\n            <option value=\"bestselling\" {{#if sort '==' 'bestselling'}}selected{{/if}}>{{lang 'common.sorter.top_sellers'}}</option>\r\n            <option value=\"alphaasc\" {{#if sort '==' 'alphaasc'}}selected{{/if}}>{{lang 'common.sorter.alpha_asc'}}</option>\r\n            <option value=\"alphadesc\" {{#if sort '==' 'alphadesc'}}selected{{/if}}>{{lang 'common.sorter.alpha_desc'}}</option>\r\n            <option value=\"avgcustomerreview\" {{#if sort '==' 'avgcustomerreview'}}selected{{/if}}>{{lang 'common.sorter.reviews'}}</option>\r\n            <option value=\"priceasc\" {{#if sort '==' 'priceasc'}}selected{{/if}}>{{lang 'common.sorter.price_asc'}}</option>\r\n            <option value=\"pricedesc\" {{#if sort '==' 'pricedesc'}}selected{{/if}}>{{lang 'common.sorter.price_desc'}}</option>\r\n            {{#if result_count}}\r\n                <option value=\"relevance\" {{#if sort '==' 'relevance'}}selected{{/if}}>{{lang 'common.sorter.relevance'}}</option>\r\n            {{/if}}\r\n        </select>\r\n    </div>\r\n</fieldset>\r\n\r\n",
  "components/category/show-products": "<fieldset class=\"form-fieldset actionBar-section\">\r\n    <div class=\"form-field\">\r\n        <label class=\"form-label\" for=\"limit\">{{lang 'common.number_products.show'}}</label>\r\n        <select class=\"form-select\" name=\"limit\" id=\"limit\">\r\n            <option value=\"9\" {{#if '9' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>9 {{lang 'common.number_products.show_text'}}</option>\r\n            <option value=\"12\" {{#if '12' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>12 {{lang 'common.number_products.show_text'}}</option>\r\n            <option value=\"15\" {{#if '15' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>15 {{lang 'common.number_products.show_text'}}</option>\r\n            <option value=\"20\" {{#if '20' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>20 {{lang 'common.number_products.show_text'}}</option>\r\n            <option value=\"24\" {{#if '24' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>24 {{lang 'common.number_products.show_text'}}</option>\r\n            <option value=\"30\" {{#if '30' '==' theme_settings.categorypage_products_per_page }}selected{{/if}}>30 {{lang 'common.number_products.show_text'}}</option>\r\n        </select>\r\n    </div>\r\n</fieldset>\r\n<script>\r\n(function(){\r\n    try {\r\n        var url = new URL(window.location.href);\r\n        var c = url.searchParams.get(\"limit\");\r\n        if(c != null){\r\n            var limit = document.querySelectorAll('select#limit option');\r\n            Array.prototype.forEach.call(limit, function(element) {\r\n                if(element.value == c){\r\n                    element.selected = true;\r\n                }\r\n            });\r\n        }\r\n    } catch(e) {}\r\n}());\r\n</script>\r\n"
}
