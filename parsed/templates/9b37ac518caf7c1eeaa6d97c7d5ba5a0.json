{
  "components/carousel-2": "<div class=\"heroCarousel heroCarousel-special\"\r\n    data-slick='{\r\n        \"fade\": true,\r\n        \"dots\": true,\r\n        \"arrows\": false,\r\n        \"autoplay\": true,\r\n        \"slidesToShow\": 1,\r\n        \"slidesToScroll\": 1,\r\n        \"mobileFirst\": true,\r\n        \"pauseOnHover\": false,\r\n        \"autoplaySpeed\": {{carousel.swap_frequency}},\r\n        \"lazyLoad\": \"anticipated\",\r\n        \"nextArrow\": \"<svg class=&apos;slick-next slick-arrow&apos;><use xlink:href=&apos;#slick-arrow-next&apos;></use></svg>\", \r\n        \"prevArrow\": \"<svg class=&apos;slick-prev slick-arrow&apos;><use xlink:href=&apos;#slick-arrow-prev&apos;></use></svg>\",\r\n        \"responsive\": [\r\n            {\r\n                \"breakpoint\": 1300,\r\n                \"settings\": {\r\n                    \"dots\": true,\r\n                    \"arrows\": false\r\n                }\r\n            }\r\n    ]}'>\r\n    {{#each carousel.slides}}\r\n    <div class=\"heroCarousel-slide {{#if ../theme_settings.homepage_stretch_carousel_images}}stretch{{/if}} {{#if @first}}heroCarousel-slide--first{{/if}}\">\r\n        <div class=\"heroCarousel-image-wrapper\">\r\n            <a class=\"link\" href=\"{{url}}\"></a>\r\n            <img class=\"heroCarousel-image\" {{#if @first}}src{{else}}src=\"{{cdn 'img/loading.svg'}}\" data-lazy{{/if}}=\"{{image}}\" alt=\"{{alt_text}}\" title=\"{{alt_text}}\" \r\n                {{#if image_width}}width=\"{{image_width}}\"{{/if}} {{#if image_height}}height=\"{{image_height}}\"{{/if}} />\r\n            {{#if heading}}\r\n                <h2 class=\"heroCarousel-title heroCarousel-titleMobile\">{{{heading}}}</h2>\r\n            {{/if}}\r\n        </div>\r\n        {{#if heading}}\r\n            {{> components/carousel-content-2 show_background=true}}\r\n        {{else}}\r\n            {{#if text}}\r\n                {{> components/carousel-content-2 show_background=true}}\r\n            {{else}}\r\n                {{#if button_text}}\r\n                    {{> components/carousel-content-2 show_background=false}}\r\n                {{/if}}\r\n            {{/if}}\r\n        {{/if}}\r\n    </div>\r\n    {{/each}}\r\n</div>\r\n<div class=\"category-filter-mobile\">\r\n</div>\r\n",
  "components/carousel-content-2": "<div class=\"heroCarousel-content-wrapper\">\r\n    <div class=\"heroCarousel-content{{#unless show_background}} heroCarousel-content--empty{{/unless}}\">\r\n        <h2 class=\"heroCarousel-title animated\">{{{heading}}}</h2>\r\n        <p class=\"heroCarousel-description animated\">{{{text}}}</p>\r\n        {{#if button_text}}\r\n            <a href=\"{{url}}\" class=\"heroCarousel-action button button--primary animated\">{{button_text}}</a>\r\n        {{/if}}\r\n    </div>\r\n</div>\r\n\r\n"
}
