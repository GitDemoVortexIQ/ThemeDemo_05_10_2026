{"components/common/quick-search":"<div class=\"container\">\n    <div class=\"quick-search-buttons\">\n        <div class=\"recent-search-box quickResults-item\">\n            <div class=\"recent-history-title\">\n                <span class=\"quickResults-item-heading\">{{lang 'common.recent_label'}}</span>\n                <span class=\"clear-all-recent\">{{lang 'search.clear_recent'}}</span>\n            </div>\n            <ul class=\"productGrid-search\">\n            </ul>\n        </div>\n        <div class=\"populer-search-box quickResults-item\">\n            <span class=\"quickResults-item-heading\">{{lang 'common.popular_label'}}</span>\n            <ul class=\"productGrid-search\">\n                {{#if theme_settings.pop-search-label-1}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-1}}\">{{theme_settings.pop-search-label-1}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-2}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-2}}\">{{theme_settings.pop-search-label-2}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-3}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-3}}\">{{theme_settings.pop-search-label-3}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-4}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-4}}\">{{theme_settings.pop-search-label-4}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-5}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-5}}\">{{theme_settings.pop-search-label-5}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-6}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-6}}\">{{theme_settings.pop-search-label-6}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n            </ul>\n        </div>        \n    </div>\n    <div class=\"search-box-cavio\">\n        <div class=\"search-label-box\">\n            <span class=\"search-cavio-label\"> {{lang 'common.search_text'}}</span>\n            {{#if theme_settings.searchlayout '==' 'SearchLayout1'}} \n                <div class=\"search-close-button\">\n                    <button class=\"modal-close\"\n                        type=\"button\"\n                        title=\"{{lang 'common.close_search'}}\"\n                        data-drop-down-close\n                    >\n                        <span class=\"aria-description--search\">{{lang 'common.close_search'}}</span>\n                        <span aria-hidden=\"true\" class=\"icon--search-close\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </button>\n                </div>\n            {{else}} \n                <div class=\"search-close-button\">\n                    <button class=\"modal-close layout-two-close\"\n                        type=\"button\"\n                        title=\"{{lang 'common.close_search'}}\"\n                    >\n                        <span class=\"aria-description--search\">{{lang 'common.close_search'}}</span>\n                        <span aria-hidden=\"true\" class=\"icon--search-close\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </button>\n                </div>            \n            {{/if}}\n\n        </div>\n        <form class=\"form\" onsubmit=\"return false\" data-url=\"{{urls.search}}\" data-quick-search-form>\n            <fieldset class=\"form-fieldset\">\n                <div class=\"form-field\">\n                    <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                    <input class=\"form-input\"\n                           data-search-quick\n                           name=\"{{name}}\"\n                           id=\"{{name}}\"\n                           data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                           placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                           autocomplete=\"off\"\n                    >\n                    <svg class=\"cavio-input-icon\"><use xlink:href=\"#icon-cavio_search\"></use></svg>\n                </div>\n            </fieldset>\n        </form>\n        <div class=\"quick-search-result-wrapper\">\n        <section class=\"quickSearchResults desktop-search hide-pagination\" data-bind=\"html: results\"></section>\n        </div>\n        <p role=\"status\"\n           aria-live=\"polite\"\n           class=\"aria-description--hidden\"\n           data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n        ></p>        \n    </div>\n    <section class=\"quickSearchResults mobile-search hide-pagination\" data-bind=\"html: results\"></section>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n"}
