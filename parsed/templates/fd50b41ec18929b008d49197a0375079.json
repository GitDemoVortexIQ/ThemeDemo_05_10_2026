{
  "components/common/breadcrumbs": "<nav aria-label=\"Breadcrumb\">\n    <ol class=\"breadcrumbs\">\n        {{#unless theme_settings.hide_breadcrumbs }}\n            {{#each breadcrumbs}}\n                {{#if @last}}\n                    {{assignVar \"url\" url }}\n                {{/if}}\n            {{/each}}\n            {{#each breadcrumbs}}\n                {{#if name '===' 'Modelos de Bicicleta'}}\n                    {{#all @index '===' 1 name '===' 'Modelos de Bicicleta'}}\n                        <li class=\"breadcrumb\">\n                            <a class=\"breadcrumb-label\" id=\"custom-brand\"\n                                href=\"{{getVar \"url\"}}\"\n                            >\n                                <span id=\"brandname\" style=\"display: none;\">{{name}}</span>\n                            </a>\n                        </li>\n                    {{/all}}\n                {{else}}\n                    <li class=\"breadcrumb {{#if @last}}is-active{{/if}}\">\n                        <a class=\"breadcrumb-label\"\n                            href=\"{{url}}\"\n                            {{#if @last}}aria-current=\"page\"{{/if}}\n                        >\n                            <span>{{name}}</span>\n                        </a>\n                    </li>\n                {{/if}}\n            {{/each}}\n        {{/unless}}\n    </ol>\n</nav>\n\n<script type=\"application/ld+json\">\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"BreadcrumbList\",\n    \"itemListElement\":\n    [\n        {{#each breadcrumbs}}\n        {\n            \"@type\": \"ListItem\",\n            \"position\": {{add @index 1}},\n            \"item\": {\n                \"@id\": {{{JSONstringify url}}},\n                \"name\": {{{JSONstringify name}}}\n            }\n        }{{#unless @last}},{{/unless}}\n        {{/each}}\n    ]\n}\n</script>\n\n\n<script>\n    document.addEventListener('DOMContentLoaded', function() {\n    const customBrandLink = document.querySelector('#custom-brand');\n\n    if (customBrandLink) {\n        let url = customBrandLink.getAttribute('href');\n\n        // Split the URL into parts using '/' as delimiter\n        let urlParts = url.split('/');\n\n        // Remove the last element from the URL (pop the last element)\n        urlParts.pop();\n\n        // Get the second-to-last element (brand name)\n        let brandName = urlParts[urlParts.length - 1];\n        brandName = brandName\n            .replace(/-/g, ' ')\n            .split(' ') // Split into words by space\n            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n            .join(' ');\n\n        const brandnameElement = document.getElementById('brandname');\n        if (brandnameElement) {\n            brandnameElement.textContent = brandName; \n            brandnameElement.style.display = 'inline';\n        }\n\n        // Rebuild the modified URL\n        const newUrl = urlParts.join('/');\n\n        customBrandLink.setAttribute('href', newUrl);\n    }\n});\n</script>"
}