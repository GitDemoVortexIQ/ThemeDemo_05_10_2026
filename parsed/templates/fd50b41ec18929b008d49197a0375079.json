{
  "components/common/breadcrumbs": "<ul class=\"breadcrumbs\" itemscope itemtype=\"http://schema.org/BreadcrumbList\">\n    {{#each breadcrumbs}}\n        <li class=\"breadcrumb {{#if @last}}is-active{{/if}}\" itemprop=\"itemListElement\" itemscope itemtype=\"http://schema.org/ListItem\">\n            {{#if url}}\n               {{#if name '===' 'Your Cart'}}\n                     <a href=\"{{url}}\" class=\"breadcrumb-label\" itemprop=\"item\">Your Basket</a>\n               {{else}}\n                   {{#if name '===' 'Gift Certificates'}}\n                         <a href=\"{{url}}\" class=\"breadcrumb-label\" itemprop=\"item\">e-Gift Cards</a>\n                   {{else}}\n                        <a href=\"{{url}}\" class=\"breadcrumb-label sub-title\" itemprop=\"item\">{{name}}</a>\n                   {{/if}}\n               {{/if}}\n            {{else}} \n              <span class=\"breadcrumb-label sub-title\" itemprop=\"name\">{{name}}</span>\n            {{/if}}\n            <meta itemprop=\"position\" content=\"{{@index}}\" />\n            <meta itemprop=\"name\" content=\"{{name}}\">\n        </li>\n    {{/each}}\n</ul>\n"
}
