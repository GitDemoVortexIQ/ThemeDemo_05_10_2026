{"components/category/sort-box":"<fieldset class=\"form-fieldset actionBar-section\">\n    <div class=\"form-field\">\n        <label class=\"form-label\" for=\"sort\">{{lang 'common.sorter.sort_by'}}</label>\n        <select class=\"form-select form-select--small \" name=\"sort\" id=\"sort\" role=\"listbox\">\n            <option value=\"featured\" {{#if sort '==' 'featured'}}selected{{/if}}>{{lang 'common.sorter.featured'}}</option>\n            <option value=\"newest\" {{#if sort '==' 'newest'}}selected{{/if}}>{{lang 'common.sorter.newest'}}</option>\n            <option value=\"bestselling\" {{#if sort '==' 'bestselling'}}selected{{/if}}>{{lang 'common.sorter.top_sellers'}}</option>\n            <option value=\"alphaasc\" {{#if sort '==' 'alphaasc'}}selected{{/if}}>{{lang 'common.sorter.alpha_asc'}}</option>\n            <option value=\"alphadesc\" {{#if sort '==' 'alphadesc'}}selected{{/if}}>{{lang 'common.sorter.alpha_desc'}}</option>\n            <option value=\"avgcustomerreview\" {{#if sort '==' 'avgcustomerreview'}}selected{{/if}}>{{lang 'common.sorter.reviews'}}</option>\n            <option value=\"priceasc\" {{#if sort '==' 'priceasc'}}selected{{/if}}>{{lang 'common.sorter.price_asc'}}</option>\n            <option value=\"pricedesc\" {{#if sort '==' 'pricedesc'}}selected{{/if}}>{{lang 'common.sorter.price_desc'}}</option>\n            {{#if result_count}}\n                <option value=\"relevance\" {{#if sort '==' 'relevance'}}selected{{/if}}>{{lang 'common.sorter.relevance'}}</option>\n            {{/if}}\n        </select>\n    </div>\n</fieldset>\n","components/cavio/top-search-filter-options":"<div class=\"filter-buttons top-filter-section\">\n    <div class=\"top-filter-options\">\n        {{#if product_results.faceted_search_enabled}}\n            <a href=\"javascript:void(0)\" class=\"filter-visibility-button\">\n                <svg class=\"icon\"><use xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"#icon-cavio_filter\"></use></svg>\n                <span class=\"visible-filter\">Show Filters</span>\n                <span class=\"hide-filter\">Hide Filters</span>\n            </a>\n        {{else if product_results.shop_by_price}}\n            {{#if theme_settings.shop_by_price_visibility}}\n            <a href=\"javascript:void(0)\" class=\"filter-visibility-button\">\n                <svg class=\"icon\"><use xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"#icon-cavio_filter\"></use></svg>\n                <span class=\"visible-filter\">Show Filters</span>\n                <span class=\"hide-filter\">Hide Filters</span>\n            </a>\n            {{/if}}\n        {{/if}}         \n        {{#if product_results.faceted_search_enabled}}\n            {{#if product_results.selected.items}}\n                <ul class=\"inlineList inlineList--labels\">\n                    {{#each product_results.selected.items}}\n                        <li>\n                            <a href=\"{{url}}\"\n                               class=\"facetLabel\"\n                               rel=\"nofollow\"\n                               data-faceted-search-facet\n                            >\n                                {{#if facet '===' 'rating'}}\n                                    {{lang 'search.faceted.selected.rating-label' rating=title}}\n                                {{else}}\n                                    {{{sanitize title}}}\n                                {{/if}}\n\n                                <svg class=\"icon\">\n                                    <use href=\"#icon-close\" />\n                                </svg>\n                            </a>\n                        </li>\n                    {{/each}}\n                {{/if}}\n            {{/if}}\n            {{#if product_results.selected.remove_all_url}}\n                <li>\n                    <a href=\"{{product_results.selected.remove_all_url}}\"  class=\"remove-link\" data-faceted-search-facet>\n                        {{lang 'search.faceted.selected.clear-all'}}\n                    </a>\n                </li>\n            {{/if}}              \n        {{#if product_results.faceted_search_enabled}}\n            {{#if product_results.selected.items}}\n                </ul>\n            {{/if}}\n        {{/if}}\n    </div>\n    {{> components/products/filter sort=pagination.product_results.sort}}\n</div>\n","components/products/filter":"<span class=\"product-count\" {{#if page_type '==' 'brand'}} data-count=\"{{brand.products.length}}\"{{/if}}> \n    {{#if page_type '==' 'brand'}}\n        {{brand.products.length}} Products\n    {{/if}}\n\n    {{#if page_type '==' 'category' }}\n        {{category.total_products}} Products\n    {{/if}} \n</span>\n<form class=\"actionBar\" method=\"get\" data-sort-by=\"product\">\n    {{> components/category/sort-box sort=sort}}\n</form>\n"}
