{
  "components/themevale/header/navigation-3": "<nav class=\"navUser\">\r\n    <div class=\"container\">\r\n        <div class=\"navUser--left\">\r\n            <div class=\"navUser-item layout-2\">\r\n                <svg class=\"icon big\"><use xlink:href=\"#icon-check\"></use></svg>\r\n                <a class=\"navUser-action\" href=\"#\">{{theme_settings.themevale_topbar-owntext1}}</a>\r\n            </div>\r\n            <div class=\"navUser-item layout-2\">\r\n                <svg class=\"icon big\"><use xlink:href=\"#icon-check\"></use></svg>\r\n                <a class=\"navUser-action\" href=\"#\">{{theme_settings.themevale_topbar-owntext2}}</a>\r\n            </div>\r\n            <div class=\"navUser-item layout-2\">\r\n                <svg class=\"icon big\"><use xlink:href=\"#icon-check\"></use></svg>\r\n                <a class=\"navUser-action\" href=\"#\">{{theme_settings.themevale_topbar-owntext3}}</a>\r\n            </div>\r\n        </div>\r\n        <div class=\"navUser--right\">\r\n            <div class=\"navUser-item navUser-item--myaccount\">\r\n                {{#if customer}}\r\n                    <a class=\"navUser-action navUser-action--myaccount\" href=\"{{urls.account.index}}\">\r\n                        {{lang 'common.myaccount'}} <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-chevron-down\" /></svg></i>\r\n                    </a>\r\n                    <ul class=\"dropdown-menu\" id=\"navPages-account-topbar\">\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.orders.all}}\">{{lang 'account.nav.orders'}}</a>\r\n                        </li>\r\n                        {{#if settings.returns_enabled}}\r\n                            <li class=\"dropdown-menu-item\">\r\n                                <a href=\"{{urls.account.returns}}\">{{lang 'account.nav.returns'}}</a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.inbox}}\">{{lang 'account.mobile_nav.messages'}}</a>\r\n                        </li>\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.addresses}}\">{{lang 'account.nav.addresses'}}</a>\r\n                        </li>\r\n                        {{#if settings.show_payment_methods}}\r\n                            <li class=\"dropdown-menu-item\">\r\n                                <a href=\"{{urls.account.payment_methods.all}}\">{{lang 'account.nav.payment_methods'}}</a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.wishlists.all}}\">{{lang 'account.mobile_nav.wishlists'}}</a>\r\n                        </li>\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.recent_items}}\">{{lang 'account.nav.recently_viewed'}}</a>\r\n                        </li>\r\n                        <li class=\"dropdown-menu-item\">\r\n                            <a href=\"{{urls.account.details}}\">{{lang 'account.nav.settings'}}</a>\r\n                        </li>\r\n                        <li class=\"dropdown-menu-item\">\r\n                        <a href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\r\n                    </li>\r\n                    </ul>\r\n                {{else}}\r\n                    <a class=\"navUser-action\" href=\"{{urls.auth.login}}\">{{lang 'common.myaccount'}}</a>\r\n                {{/if}}\r\n            </div>\r\n            {{#if settings.gift_certificates_enabled}}\r\n                <div class=\"navUser-item\">\r\n                    <a class=\"navUser-action\" href=\"{{urls.gift_certificate.purchase}}\">{{lang 'common.gift_cert'}}</a>\r\n                </div>\r\n            {{/if}}\r\n            <div class=\"navUser-item navUser-item--account\">\r\n                {{#if customer}}\r\n                    <a class=\"navUser-action\" href=\"{{urls.account.index}}\"><strong>{{customer.name}}.</strong></a>\r\n                    <a class=\"navUser-action\" href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\r\n                {{else}}\r\n                    <a class=\"navUser-action\" href=\"javascript:void(0)\" data-login-form>{{lang 'common.login'}}</a>\r\n                    {{#if settings.account_creation_enabled}}\r\n                    {{#if page_type '!==' 'login'}}\r\n                        {{> components/common/login-form}}\r\n                    {{/if}}\r\n                    <span class=\"navUser-or\">{{lang 'common.or'}}</span>\r\n                    <a class=\"navUser-action\" href=\"{{urls.auth.create_account}}\">{{lang 'common.create_account'}}</a>\r\n                    {{/if}}\r\n                {{/if}}\r\n            </div>\r\n            <!-- <div class=\"navUser-item navUser-item--compare show\">\r\n                <a class=\"navUser-action\" href=\"{{urls.compare}}\" data-compare-nav>{{lang 'common.compare'}} (<span class=\"countPill\">0</span>)</a>\r\n            </div> -->\r\n            <div class=\"navUser-item\">\r\n                {{> components/common/currency-selector}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</nav>\r\n",
  "components/common/login-form": "<div class=\"login-dropdown\" id=\"login-dropdown\">\r\n    <div class=\"login-header\">\r\n        <h2 class=\"login-title\">{{lang 'login.new_customer.heading2' }}</h2>\r\n        <a href=\"#\" class=\"login-close\" role=\"button\">\r\n            <span aria-hidden=\"true\">&#215;</span>\r\n        </a>\r\n    </div>\r\n    <div class=\"login-content\">\r\n        <p class=\"login-intro\">{{lang 'login.new_customer.intro2' }}</p>\r\n        <form class=\"login-form form\" action=\"{{settings.secure_base_url}}/login.php?action=check_login\" method=\"post\">\r\n            {{inject 'useValidEmail' (lang 'forms.validate.common.email_address')}}\r\n            {{inject 'enterPass' (lang 'forms.validate.common.password')}}\r\n            <div class=\"form-field\">\r\n                <label class=\"form-label\" for=\"login_email2\">{{lang 'login.field_email'}}</label>\r\n                <input class=\"form-input\" name=\"login_email\" id=\"login_email2\" type=\"email\">\r\n            </div>\r\n            <div class=\"form-field\">\r\n                <label class=\"form-label\" for=\"login_pass2\">{{lang 'login.field_password'}}</label>\r\n                <input class=\"form-input\" id=\"login_pass2\" type=\"password\" name=\"login_pass\">\r\n            </div>\r\n            <div class=\"form-actions\">\r\n                <a class=\"forgot-password\" href=\"{{urls.auth.forgot_password}}\">{{lang 'login.forgot_password' }}</a>\r\n                <input type=\"submit\" class=\"button button--transparent\" value=\"{{lang 'login.button' }}\">\r\n            </div>\r\n        </form>\r\n    </div>\r\n    <div class=\"new-customer\">\r\n        {{#if settings.account_creation_enabled}}\r\n            <p class=\"new-customer-intro\">{{lang 'login.new_customer.intro3' }}</p>\r\n            <a class=\"button\" href=\"{{urls.auth.create_account}}\">{{lang 'create_account.button' }}</a>\r\n        {{/if}}\r\n    </div>\r\n</div>\n",
  "components/common/currency-selector": "{{#if currency_selector.currencies.length '>' 1}}\n<ul class=\"navUser-section\">\n    <li class=\"navUser-item\">\n        <a class=\"navUser-action navUser-action--currencySelector\" href=\"#\">\n            <span class=\"image-flag\">{{{currency_selector.active_currency_flag}}}</span> \n            <span class=\"text-flag\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n            <i class=\"icon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-chevron-down\" /></svg></i></a>\n        <ul class=\"dropdown-menu\" id=\"currencySelection\">\n            {{#each currency_selector.currencies}}\n            <li class=\"dropdown-menu-item\">\n                <a href=\"{{{switch_url}}}\">\n                    {{#if is_active}}\n                    {{{flag}}} <strong>{{name}}</strong>\n                    {{else}}\n                    {{{flag}}} {{name}}\n                    {{/if}}\n                </a>\n            </li>\n            {{/each}}\n        </ul>\n    </li>\n</ul>\n{{/if}}\n"
}
