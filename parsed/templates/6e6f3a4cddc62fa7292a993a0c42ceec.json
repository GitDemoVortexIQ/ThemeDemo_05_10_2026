></use></svg>\r\n                        </span>                 \r\n                    </div>\r\n                    <div class=\"navPage-subMenu\" id=\"navPages-{{dashcase (lowercase (sanitize name))}}\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                        <ul class=\"navPage-subMenu-list navPage-subMenu-wrap\">\r\n                            {{#each children}}\r\n                                <li class=\"navPage-subMenu-item navPage-child-item\">\r\n                                    {{#if children}}\r\n                                        <div class=\"nav-menu-title-wrapper\">\r\n                                            <a class=\"navPage-subMenu-action navPages-action has-subMenu{{#if is_active}} activePage{{/if}}\"\r\n                                               href=\"{{url}}\"\r\n                                               aria-label=\"{{name}}\"\r\n                                            >\r\n                                                {{name}}\r\n                                                <span class=\"collapsible-icon-wrapper\"\r\n                                                    data-collapsible=\"navPages-{{dashcase (lowercase (sanitize name))}}\"\r\n                                                    data-collapsible-disabled-breakpoint=\"medium\"\r\n                                                    data-collapsible-disabled-state=\"open\"\r\n                                                    data-collapsible-enabled-state=\"closed\"\r\n                                                >\r\n                                                    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                                                        <svg><use href=\"#icon-cavio_expand-right\" /></svg>\r\n                                                    </i>\r\n                                                </span>\r\n                                            </a>\r\n                                            <span class=\"collapsible-icon-wrapper-cavio-mobile\"> \r\n                                                <svg><use href=\"#icon-cavio_angle-right\"></use></svg>\r\n                                            </span>\r\n                                        </div>\r\n                                        <ul class=\"navPage-childList navPage-subMenu-wrap\" id=\"navPages-{{dashcase (lowercase (sanitize name))}}\">\r\n                                            {{#each children}}\r\n                                            <li class=\"navPage-childList-item navPage-child-item\">\r\n                                                <a class=\"navPage-childList-action navPages-action{{#if name '==' ../page.title}} activePage{{/if}}\"\r\n                                                   href=\"{{url}}\"\r\n                                                   aria-label=\"{{name}}\"\r\n                                                >\r\n                                                    {{name}}\r\n                                                </a>\r\n                                            </li>\r\n                                            {{/each}}\r\n                                        </ul>\r\n                                    {{else}}\r\n                                        <a class=\"navPage-subMenu-action navPages-action{{#if name '==' ../page.title}} activePage{{/if}}\"\r\n                                           href=\"{{url}}\"\r\n                                           aria-label=\"{{name}}\"\r\n                                        >\r\n                                            {{name}}\r\n                                        </a>\r\n                                    {{/if}}\r\n                                </li>\r\n                            {{/each}}\r\n                        </ul>\r\n                    </div>\r\n                    {{else}}\r\n                    <a class=\"navPages-action{{#if name '==' ../page.title}} activePage{{/if}}\"\r\n                       href=\"{{url}}\"\r\n                       aria-label=\"{{name}}\"\r\n                    >\r\n                        {{name}}\r\n                    </a>\r\n                    {{/if}}\r\n                 </li>\r\n             {{/each}}\r\n        {{/unless}}\r\n    </ul>\r\n    <ul class=\"navPages-list navPages-list--user\">\r\n        {{#if currency_selector.currencies.length '>' 1}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action has-subMenu\"\r\n                   href=\"#\"\r\n                   data-collapsible=\"navPages-currency\"\r\n                   aria-controls=\"navPages-currency\"\r\n                   aria-expanded=\"false\"\r\n                   aria-label=\"{{lang 'common.currency' code=currency_selector.active_currency_code}}\"\r\n                >\r\n                    {{lang 'common.currency' code=currency_selector.active_currency_code}}\r\n                    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                        <svg>\r\n                            <use href=\"#icon-chevron-down\"></use>\r\n                        </svg>\r\n                    </i>\r\n                </a>\r\n                <div class=\"navPage-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                    <ul class=\"navPage-subMenu-list\">\r\n                        {{#each currency_selector.currencies}}\r\n                        <li class=\"navPage-subMenu-item\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\"\r\n                               href=\"{{{switch_url}}}\"\r\n                               aria-label=\"{{name}}\"\r\n                               data-currency-code=\"{{{code}}}\"\r\n                               {{#if cart_currency_switch_url.length '>' 0 }}\r\n                               data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\r\n                               {{/if}}\r\n                               data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\r\n                            >\r\n                                {{#if is_active}}\r\n                                    <strong>{{name}}</strong>\r\n                                {{else}}\r\n                                    {{name}}\r\n                                {{/if}}\r\n                            </a>\r\n                        </li>\r\n                        {{/each}}\r\n                    </ul>\r\n                </div>\r\n            </li>\r\n        {{/if}}\r\n        {{#if settings.gift_certificates_enabled}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\"\r\n                   href=\"{{urls.gift_certificate.purchase}}\"\r\n                   aria-label=\"{{lang 'common.gift_cert'}}\"\r\n                >\r\n                    {{lang 'common.gift_cert'}}\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if customer.store_credit.value '>' 0}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action navPages-action--storeCredit\">\r\n                    {{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if theme_settings.product_list_display_mode '==' 'list'}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action navPages-action--compare\"\r\n                   href=\"{{urls.compare}}\"\r\n                   data-compare-nav\r\n                   aria-label=\"{{lang 'common.compare'}}\"\r\n                >\r\n                    {{lang 'common.compare'}}\r\n                    <span class=\"countPill countPill--positive countPill--alt\"></span>\r\n                </a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if customer}}\r\n         