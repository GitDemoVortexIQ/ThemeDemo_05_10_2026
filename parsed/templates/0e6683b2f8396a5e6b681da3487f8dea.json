{
  "components/themevale/homepage/component/recent-post-list-3": "<div class=\"themevale_section themevale_bgGray\" id=\"themevale_blogs\">\r\n    <div class=\"container\">\r\n        <div class=\"themevale_recent_posts_wrapper\">\r\n            <div class=\"themevale_page-heading-wrapper text-left\">\r\n                <h2 class=\"page-heading\">Recent Blog Posts</h2>\r\n                <p class=\"description\">Donec placerat de dictum ornare. Phasellus danos interdum an dipsum malesuada blandit cosmopolis delemento massa lorem mollis delous.</p>\r\n                <a href=\"/blog/\" class=\"themevale_link custom\">\r\n                    <span>View All Posts</span> \r\n                    <svg class=\"icon icon-view\"><use xlink:href=\"#icon-chevron-right\"></use></svg>\r\n                </a>\r\n            </div>\r\n            <div class=\"themevale_content\"> \r\n                {{#if blog.recent_posts}}\r\n                    <ul class=\"themevale_column themevale_column--col{{theme_settings.homepage_blog_posts_count}}\">\r\n                        {{#each blog.recent_posts}}\r\n                            <li class=\"item\">\r\n                                {{> components/blog/recent_post-2 post=this settings=../settings}}\r\n                            </li>\r\n                        {{/each}}\r\n                    </ul>\r\n                {{/if}}\r\n            </div>\r\n        </div>\r\n        {{{region name=\"below_recent_post_list\"}}}\r\n    </div>\r\n</div>\r\n",
  "components/blog/recent_post-2": "<article class=\"blog recent-post post-first\">\r\n    <div class=\"blog-post-figure\">\r\n        {{#if post.thumbnail}}\r\n            <figure class=\"blog-thumbnail\">\r\n                <a href=\"{{post.url}}\">\r\n                    <img src=\"{{getImage post.thumbnail 'recent_post_size'}}\" alt=\"{{post.thumbnail.alt}}\" title=\"{{post.thumbnail.alt}}\">\r\n                </a>\r\n            </figure>\r\n        {{/if}}\r\n    </div>\r\n    <div class=\"blog-post-body\">\r\n        <div class=\"blog-header\">\r\n            <h2 class=\"blog-title\">\r\n                <a href=\"{{post.url}}\">{{post.title}}</a>\r\n            </h2>\r\n            <p class=\"blog-date\">{{#if post.author}}{{lang 'blog.posted_by' name=post.author}} on {{/if}}{{post.date_published}}</p>\r\n        </div>\r\n        <div class=\"blog-post\">\r\n            {{{post.summary}}}\r\n            {{#if post.show_read_more}}\r\n                &hellip;\r\n                <a href=\"{{url}}\">read more</a>\r\n            {{/if}}\r\n        </div>\r\n    </div>\r\n</article>\r\n"
}
