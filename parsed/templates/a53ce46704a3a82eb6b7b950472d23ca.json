{
  "components/carousel": "<section class=\"heroCarousel\"\n    data-slick='{\n        \"fade\": true,\n        \"dots\": true,\n        \"arrows\": false,\n        \"autoplay\": true,\n        \"slidesToShow\": 1,\n        \"slidesToScroll\": 1,\n        \"mobileFirst\": true,\n        \"pauseOnHover\": false,\n        \"autoplaySpeed\": {{carousel.swap_frequency}},\n        \"lazyLoad\": \"anticipated\",\n        \"nextArrow\": \"<svg class=&apos;slick-next slick-arrow&apos;><use xlink:href=&apos;#slick-arrow-next&apos;></use></svg>\", \n        \"prevArrow\": \"<svg class=&apos;slick-prev slick-arrow&apos;><use xlink:href=&apos;#slick-arrow-prev&apos;></use></svg>\",\n        \"responsive\": [\n            {\n                \"breakpoint\": 1300,\n                \"settings\": {\n                    \"dots\": true,\n                    \"arrows\": true\n                }\n            }\n    ]}'>\n    {{#each carousel.slides}}\n    <div class=\"heroCarousel-slide {{#if ../theme_settings.homepage_stretch_carousel_images}}stretch{{/if}} {{#if @first}}heroCarousel-slide--first{{/if}}\">\n        <div class=\"heroCarousel-image-wrapper\">\n            <a class=\"link\" href=\"{{url}}\"></a>\n            <img class=\"heroCarousel-image\" {{#if @first}}src{{else}}src=\"{{cdn 'img/loading.svg'}}\" data-lazy{{/if}}=\"{{image}}\" alt=\"{{alt_text}}\" title=\"{{alt_text}}\" \n                {{#if image_width}}width=\"{{image_width}}\"{{/if}} {{#if image_height}}height=\"{{image_height}}\"{{/if}} />\n            {{#if heading}}\n                <h2 class=\"heroCarousel-title heroCarousel-titleMobile\">{{{heading}}}</h2>\n            {{/if}}\n        </div>\n        {{#if heading}}\n            {{> components/carousel-content show_background=true}}\n        {{else}}\n            {{#if text}}\n                {{> components/carousel-content show_background=true}}\n            {{else}}\n                {{#if button_text}}\n                    {{> components/carousel-content show_background=false}}\n                {{/if}}\n            {{/if}}\n        {{/if}}\n    </div>\n    {{/each}}\n</section>\n",
  "components/carousel-content": "<div class=\"container heroCarousel-content-wrapper\">\n    <div class=\"heroCarousel-content{{#unless show_background}} heroCarousel-content--empty{{/unless}}\">\n        <h2 class=\"heroCarousel-title animated\">{{{heading}}}</h2>\n        <p class=\"heroCarousel-description animated\">{{{text}}}</p>\n        {{#if button_text}}\n            <a href=\"{{url}}\" class=\"heroCarousel-action button button--primary animated\">{{button_text}}</a>\n        {{/if}}\n    </div>\n</div>\n"
}
