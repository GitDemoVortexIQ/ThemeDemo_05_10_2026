{
  "components/themevale/homepage/component/ajax-products-by-category-sorting-tabs-2": "<div class=\"themevale_sectionChild\">\r\n    {{#each categories}}\r\n        {{#if id '==' ../category_id}}\r\n            <div class=\"themevale_productsByCategoryTabs\">\r\n                <h2 class=\"page-heading\"><a href=\"{{url}}\">{{name}}</a></h2>\r\n                {{> components/themevale/homepage/component/ajax-products-by-category-sorting-tabs-content\r\n                    image-1=../../theme_settings.themevale_category-id-width-banner-2-image-1\r\n                    image-2=../../theme_settings.themevale_category-id-width-banner-2-image-2\r\n                    image-3=../../theme_settings.themevale_category-id-width-banner-2-image-3 }}\r\n            </div>\r\n            <div class=\"themevale_bannerbycategory themevale_bannerbycategory_2\">\r\n                <div class=\"themevale_bannerbycategory-carousel\" data-slick='{\r\n                    \"arrows\": false,\r\n                    \"dots\": true,\r\n                    \"infinite\": false,\r\n                    \"slidesToShow\": 4,\r\n                    \"slidesToScroll\": 4\r\n                    }'>\r\n                    <div class=\"item\">\r\n                        <div class=\"bannerbycategory-wrapper\">\r\n                            <div class=\"image\">\r\n                                <a href=\"#\"><img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/banner-marketing-ex-1.jpg\" alt=\"\"></a>\r\n                            </div>\r\n                            <div class=\"content\">\r\n                                <h6 class=\"title\"><a href=\"#\">Body Kits</a></h6>\r\n                                <p>Dinterdum pretium, Mauris, Condimentus</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <div class=\"bannerbycategory-wrapper\">\r\n                            <div class=\"image\">\r\n                                <a href=\"#\"><img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/banner-marketing-ex-2.jpg\" alt=\"\"></a>\r\n                            </div>\r\n                            <div class=\"content\">\r\n                                <h6 class=\"title\"><a href=\"#\">Custom Hoods</a></h6>\r\n                                <p>Dinterdum pretium, Mauris, Condimentus</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <div class=\"bannerbycategory-wrapper\">\r\n                            <div class=\"image\">\r\n                                <a href=\"#\"><img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/banner-marketing-ex-3.jpg\" alt=\"\"></a>\r\n                            </div>\r\n                            <div class=\"content\">\r\n                                <h6 class=\"title\"><a href=\"#\">Spoliers</a></h6>\r\n                                <p>Dinterdum pretium, Mauris, Condimentus</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <div class=\"bannerbycategory-wrapper\">\r\n                            <div class=\"image\">\r\n                                <a href=\"#\"><img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/banner-marketing-ex-4.jpg\" alt=\"\"></a>\r\n                            </div>\r\n                            <div class=\"content\">\r\n                                <h6 class=\"title\"><a href=\"#\">Custom Grilles</a></h6>\r\n                                <p>Dinterdum pretium, Mauris, Condimentus</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <div class=\"bannerbycategory-wrapper\">\r\n                            <div class=\"image\">\r\n                                <a href=\"#\"><img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/banner-marketing-ex-2.jpg\" alt=\"\"></a>\r\n                            </div>\r\n                            <div class=\"content\">\r\n                                <h6 class=\"title\"><a href=\"#\">Custom Hoods</a></h6>\r\n                                <p>Dinterdum pretium, Mauris, Condimentus</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        {{/if}}\r\n    {{/each}}\r\n</div>\r\n            \n",
  "components/themevale/homepage/component/ajax-products-by-category-sorting-tabs-content": "<div class=\"themevale_bannerByCategoryTabs\" >\r\n    <div class=\"themevale_bannerByCategoryTabs-carousel\" \r\n        data-slick='{\r\n            \"dots\": true,\r\n            \"arrows\": false,\r\n            \"slidesToShow\": 1,\r\n            \"slidesToScroll\": 1,\r\n            \"autoplay\": true,\r\n            \"infinite\": true,\r\n            \"autoplaySpeed\": 3000\r\n        }'>\r\n        {{#if image-1}}\r\n            <div class=\"item\">\r\n                <a href=\"{{url}}\" class=\"banner-link\">\r\n                    <img class=\"banner-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/{{image-1}}\" alt=\"\">\r\n                </a>\r\n            </div>\r\n        {{else}}\r\n        <div class=\"item\">\r\n            <a href=\"{{url}}\" class=\"banner-link\">\r\n                <img class=\"banner-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"https://via.placeholder.com/290x420\" alt=\"\">\r\n            </a>\r\n        </div>\r\n        {{/if}}\r\n        {{#if image-2}}\r\n            <div class=\"item\">\r\n                <a href=\"{{url}}\" class=\"banner-link\">\r\n                    <img class=\"banner-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/{{image-2}}\" alt=\"\">\r\n                </a>\r\n            </div>\r\n        {{/if}}\r\n        {{#if image-3}}\r\n            <div class=\"item\">\r\n                <a href=\"{{url}}\" class=\"banner-link\">\r\n                    <img class=\"banner-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/{{image-3}}\" alt=\"\">\r\n                </a>\r\n            </div>\r\n        {{/if}}\r\n    </div>\r\n</div>\r\n<ul class=\"tabs\" data-tab data-tab-themevale-products-by-category-tabs role=\"tablist\">\r\n    <li class=\"tab is-active\" role=\"presentation\">\r\n        <a class=\"tab-title\" href=\"#tab-productsByCategoryTabs-new-{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"false\" aria-controls=\"tab-productsByCategoryTabs-new-{{id}}\">{{lang 'home.tab_products.new' }}</a>\r\n    </li>\r\n    <li class=\"tab\" role=\"presentation\">\r\n        <a class=\"tab-title\" href=\"#tab-productsByCategoryTabs-bestselling-{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"true\" aria-controls=\"tab-productsByCategoryTabs-bestselling-{{id}}\">{{lang 'home.tab_products.bestselling' }}</a>\r\n    </li>\r\n    <li class=\"tab\" role=\"presentation\">\r\n        <a class=\"tab-title\" href=\"#tab-productsByCategoryTabs-featured-{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"false\" aria-controls=\"tab-productsByCategoryTabs-featured-{{id}}\">{{lang 'home.tab_products.featured' }}</a>\r\n    </li>\r\n    <li class=\"tab\" role=\"presentation\">\r\n        <a class=\"tab-title\" href=\"#tab-productsByCategoryTabs-reviews-{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"false\" aria-controls=\"tab-productsByCategoryTabs-reviews-{{id}}\">{{lang 'home.tab_products.reviews' }}</a>\r\n    </li>\r\n</ul>\r\n<div class=\"tabs-contents\">\r\n    <div role=\"tabpanel\" aria-hidden=\"true\" class=\"tab-content is-active\" id=\"tab-productsByCategoryTabs-new-{{id}}\" \r\n        data-themevale-products-by-category-tabs=\"{{concat url '?sort=newest'}}\"\r\n        data-themevale-template-products-by-category-tabs=\"themevale/homepage/component/ajax-products-by-category-sorting-tabs-result\">\r\n        {{>  components/themevale/homepage/component/product-loading}}\r\n    </div>\r\n\r\n    <div role=\"tabpanel\" aria-hidden=\"false\" class=\"tab-content\" id=\"tab-productsByCategoryTabs-bestselling-{{id}}\" \r\n        data-themevale-products-by-category-tabs=\"{{concat url '?sort=bestselling'}}\"\r\n        data-themevale-template-products-by-category-tabs=\"themevale/homepage/component/ajax-products-by-category-sorting-tabs-result\">\r\n        {{>  components/themevale/homepage/component/product-loading}}\r\n    </div>\r\n\r\n    <div role=\"tabpanel\" aria-hidden=\"true\" class=\"tab-content\" id=\"tab-productsByCategoryTabs-featured-{{id}}\" \r\n        data-themevale-products-by-category-tabs=\"{{concat url '?sort=featured'}}\"\r\n        data-themevale-template-products-by-category-tabs=\"themevale/homepage/component/ajax-products-by-category-sorting-tabs-result\">\r\n        {{>  components/themevale/homepage/component/product-loading}}\r\n    </div>\r\n\r\n    <div role=\"tabpanel\" aria-hidden=\"true\" class=\"tab-content\" id=\"tab-productsByCategoryTabs-reviews-{{id}}\" \r\n        data-themevale-products-by-category-tabs=\"{{concat url '?sort=avgcustomerreview'}}\"\r\n        data-themevale-template-products-by-category-tabs=\"themevale/homepage/component/ajax-products-by-category-sorting-tabs-result\">\r\n        {{>  components/themevale/homepage/component/product-loading}}\r\n    </div>\r\n</div>\r\n",
