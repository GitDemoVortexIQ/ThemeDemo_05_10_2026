{
  "components/brand/brands_carousel": "<div class=\"brands-carousel\" data-slick='{\r\n    \"dots\": true,\r\n    \"arrows\": false,\r\n    \"autoplay\": false,\r\n    \"slidesToShow\": 1, \r\n    \"slidesToScroll\": 1, \r\n    \"mobileFirst\": true,\r\n    \"responsive\": [\r\n        {\r\n            \"breakpoint\": 768,\r\n            \"settings\": {\r\n                \"slidesToShow\": 3,\r\n                \"slidesToScroll\": 3\r\n            }\r\n        },\r\n        {\r\n            \"breakpoint\": 430,\r\n            \"settings\": {\r\n                \"slidesToShow\": 2,\r\n                \"slidesToScroll\": 2\r\n            }\r\n        }\r\n    ] }'>\r\n    {{#each shop_by_brand}}\r\n        <div class=\"brand\">\r\n            <article class=\"brand-cart\">\r\n                <figure class=\"brand-figure\">\r\n                    <a href=\"{{url}}\">\r\n                        <div class=\"brand-img-container\">\r\n                            <img class=\"card-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{getImage image 'brand_size' (cdn ../theme_settings.default_image_brand)}}\" alt=\"{{name}}\" title=\"{{name}}\">\r\n                        </div>\r\n                    </a>\r\n                </figure>\r\n                <div class=\"brand-body\">\r\n                    <h4 class=\"brand-title\">\r\n                        <a href=\"{{url}}\">{{name}}</a>\r\n                    </h4>\r\n                </div>\r\n            </article>\r\n        </div>\r\n    {{/each}}\r\n</div>\n"
}
