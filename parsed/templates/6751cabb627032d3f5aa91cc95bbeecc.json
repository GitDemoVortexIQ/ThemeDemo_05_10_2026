{
  "components/products/options/swatch": "<div class=\"form-field\" data-product-attribute=\"swatch\" role=\"radiogroup\" aria-labelledby=\"swatchGroup_{{id}}\">\n    <label class=\"form-label form-label--alternate form-label--inlineSmall\" id=\"swatchGroup_{{id}}\">\n        {{this.display_name}}\n        <!--<span data-option-value></span>-->\n\n        {{> components/common/requireness-msg}}\n    </label>\n    <span\n        class=\"swatch-option-message aria-description--hidden u-hidden\">\n        {{ lang 'products.swatch_option_announcement' swatch_name=this.display_name}}\n    </span>\n    <div class=\"swatches-wrapper\">\n        {{#if this.values.length '>' 5}}\n            <span class=\"arrow left-arrow\" id=\"left-arrow-{{id}}\">&#8249;</span>\n        {{/if}}\n        <div class=\"swatches-container\" id=\"swatch-container-{{id}}\" style=\"display: flex; align-items: start;\">\n        {{#unless required}}\n            <input\n                class=\"form-radio\"\n                type=\"radio\"\n                name=\"attribute[{{id}}]\"\n                value=\"\"\n                id=\"attribute_swatch_{{id}}_none\"\n                checked=\"{{#if defaultValue '==' ''}}checked{{/if}}\"\n                aria-label=\"{{lang 'products.none'}}\"\n            >\n            <label class=\"form-option form-option-swatch\" for=\"attribute_swatch_{{id}}_none\">\n                <span class='form-option-variant form-option-variant--none' title=\"{{lang 'products.none'}}\">{{lang 'products.none'}}</span>\n            </label>\n        {{/unless}}\n\n        {{#each this.values}}\n        <div class=\"form-option-wrapper\">\n            <input class=\"form-radio\"\n                type=\"radio\"\n                name=\"attribute[{{../id}}]\"\n                value=\"{{id}}\"\n                id=\"attribute_swatch_{{../id}}_{{id}}\"\n                {{#if selected}}checked data-default{{/if}}\n                {{#if ../required}}required{{/if}}\n                aria-label=\"{{this.label}}\"\n            >\n            <label class=\"form-option form-option-swatch\" for=\"attribute_swatch_{{../id}}_{{id}}\" data-product-attribute-value=\"{{id}}\">\n                {{#if image}}\n                    <span class='form-option-variant form-option-variant--pattern' title=\"{{this.label}}\" style=\"background-image: url('{{getImage image \"swatch_option_size\"}}');\"></span>\n                {{/if}}\n                {{#if data.[2]}}\n                    <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[0]}}\"></span>\n                    <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[1]}}\"></span>\n                    <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[2]}}\"></span>\n                {{else}}\n                    {{#if data.[1]}}\n                        <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[0]}}\"></span>\n                        <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[1]}}\"></span>\n                    {{else}}\n                        {{#if data.[0]}}\n                            <span class='form-option-variant form-option-variant--color' title=\"{{this.label}}\" style=\"background-color: #{{data.[0]}}\"></span>\n                        {{/if}}\n                    {{/if}}\n                {{/if}}\n                {{#if pattern}}\n                    <span class=\"form-option-expanded\">\n                        <span class=\"form-option-image\" style=\"background-image: url('{{getImage image 'core-swatch'}}');\"></span>\n                    </span>\n                {{/if}}\n            </label>\n            <span class=\"color-label\">{{this.label}}</span>\n        </div>\n        {{/each}}\n        </div>\n        {{#if this.values.length '>' 5}}\n            <span class=\"arrow right-arrow\" id=\"right-arrow-{{id}}\">&#8250;</span>\n        {{/if}}\n    </div>\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        const swatchGroups = document.querySelectorAll('.swatches-container');\n\n        swatchGroups.forEach((swatchContainer) => {\n            const swatchGroupId = swatchContainer.id.split('-')[2];\n            const leftArrow = document.querySelector(`#left-arrow-${swatchGroupId}`);\n            const rightArrow = document.querySelector(`#right-arrow-${swatchGroupId}`);\n            const swatchNum = parseInt('{{this.values.length}}');\n\n            if (!swatchContainer || !leftArrow || !rightArrow) return;\n\n            const scrollAmount = 100;\n\n            function toggleArrowVisibility() {\n                const windowWidth = window.innerWidth;\n\n                // Hide arrows if swatchNum is less than 7 and window width is greater than 450px\n                if (swatchNum < 7 && windowWidth > 450) {\n                    leftArrow.style.display = 'none';\n                    rightArrow.style.display = 'none';\n                } else {\n                    leftArrow.style.display = 'block';\n                    rightArrow.style.display = 'block';\n                    updateArrowStyles();\n                }\n            }\n\n            // Update arrow styles based on scroll position\n            function updateArrowStyles() {\n                if (swatchContainer.scrollLeft > 0) {\n                    leftArrow.style.opacity = '1';\n                    leftArrow.style.pointerEvents = 'auto';\n                } else {\n                    leftArrow.style.opacity = '0.2';\n                    leftArrow.style.pointerEvents = 'none';\n                }\n\n                if (swatchContainer.scrollLeft < swatchContainer.scrollWidth - swatchContainer.clientWidth) {\n                    rightArrow.style.opacity = '1';\n                    rightArrow.style.pointerEvents = 'auto';\n                } else {\n                    rightArrow.style.opacity = '0.2';\n                    rightArrow.style.pointerEvents = 'none';\n                }\n            }\n\n            // Scroll left\n            leftArrow.addEventListener('click', () => {\n                swatchContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });\n                setTimeout(updateArrowStyles, 300);\n            });\n\n            // Scroll right\n            rightArrow.addEventListener('click', () => {\n                const maxScroll = swatchContainer.scrollWidth - swatchContainer.clientWidth;\n                const remainingScroll = maxScroll - swatchContainer.scrollLeft;\n\n                swatchContainer.scrollBy({\n                    left: Math.min(scrollAmount, remainingScroll),\n                    behavior: 'smooth',\n                });\n                setTimeout(updateArrowStyles, 300);\n            });\n\n            // Update arrow styles on load and on scroll\n            window.addEventListener('load', () => {\n                toggleArrowVisibility();\n                updateArrowStyles();\n            });\n\n            window.addEventListener('resize', toggleArrowVisibility);\n            swatchContainer.addEventListener('scroll', updateArrowStyles);\n        });\n    });\n</script>",
  "components/common/requireness-msg": "<small {{#if required}}class=\"is-required\"{{/if}}>\n    {{#if required}}\n        *\n    {{else}}\n    {{lang 'common.optional'}}\n    {{/if}}\n</small>\n"
}
