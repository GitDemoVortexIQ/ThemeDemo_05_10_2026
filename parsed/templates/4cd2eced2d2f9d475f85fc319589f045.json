{"components/cavio/cavio-navigation-list":"{{#if categories}}\r\n    <div class=\"navPage-subMenu nav-pages-horizonal\" id=\"navPages-shop\" aria-hidden=\"true\" tabindex=\"-1\">\r\n        <ul class=\"navPage-subMenu-list\">\r\n            {{#each categories}}\r\n            {{#if this.name '==' ../theme_settings.category-name-of-category-filter}}\r\n            {{else}}            \r\n                <li class=\"navPage-subMenu-item\">\r\n                    {{#if children}}\r\n                        <div class=\"nav-menu-title-wrapper\">\r\n                            <a class=\"navPage-subMenu-action navPages-action has-subMenu{{#if is_active}} activePage{{/if}}\"\r\n                               href=\"{{url}}\"\r\n                               aria-label=\"{{name}}\"\r\n                            >\r\n                                {{#if image}}\r\n                                    <div class=\"nav-category-img\">\r\n                                        <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{getImage image}}\" alt=\"{{image.alt}}\" title=\"{{image.alt}}\">\r\n                                    </div>\r\n                                {{else}}\r\n                                    <div class=\"nav-category-img coming-soon-image\">\r\n                                        <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{cdn '/assets/img/CavioDefault.gif'}}\" alt=\"{{image.alt}}\" title=\"{{image.alt}}\">\r\n                                    </div>\r\n                                {{/if}}\r\n                                <span class=\"nav-category-title\">{{name}}</span>\r\n                                <span class=\"collapsible-icon-wrapper\"\r\n                                    data-collapsible=\"navPages-{{id}}\"\r\n                                    data-collapsible-disabled-breakpoint=\"medium\"\r\n                                    data-collapsible-disabled-state=\"open\"\r\n                                    data-collapsible-enabled-state=\"closed\"\r\n                                >\r\n                                    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                                        <svg><use href=\"#icon-chevron-down\" /></svg>\r\n                                    </i>\r\n                                </span>\r\n                            </a>\r\n                            <span class=\"collapsible-icon-wrapper-cavio-mobile\"> \r\n                                <svg><use href=\"#icon-cavio_angle-right\"></use></svg>\r\n                            </span>                              \r\n                        </div>\r\n                        <ul class=\"navPage-childList\" id=\"navPages-{{id}}\">\r\n                            {{#each children}}\r\n                            <li class=\"navPage-childList-item\">\r\n                                <a class=\"navPage-childList-action navPages-action{{#if is_active}} activePage{{/if}}\"\r\n                                   href=\"{{url}}\"\r\n                                   aria-label=\"{{name}}\"\r\n                                >\r\n                                    {{name}}\r\n                                </a>\r\n                            </li>\r\n                            {{/each}}\r\n                        </ul>\r\n                    {{else}}\r\n                        <div class=\"nav-menu-title-wrapper\">\r\n                            <a class=\"navPage-subMenu-action navPages-action {{#if is_active}} activePage{{/if}}\"\r\n                               href=\"{{url}}\"\r\n                               aria-label=\"{{name}}\"\r\n                            >\r\n                                {{#if image}}\r\n                                    <div class=\"nav-category-img\">\r\n                                        <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{getImage image}}\" alt=\"{{image.alt}}\" title=\"{{image.alt}}\">\r\n                                    </div>\r\n                                {{else}}\r\n                                    <div class=\"nav-category-img coming-soon-image\">\r\n                                        <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{cdn '/assets/img/CavioDefault.gif'}}\" alt=\"{{image.alt}}\" title=\"{{image.alt}}\">\r\n                                    </div>\r\n                                {{/if}}\r\n                                <span class=\"nav-category-title\">{{name}}</span>\r\n                            </a>                            \r\n                        </div>\r\n                    {{/if}}\r\n                </li>\r\n            {{/if}}\r\n            {{/each}}\r\n        </ul>\r\n    </div>\r\n{{/if}}\r\n"}
