{
  "components/themevale/homepage/component/ajax-products-by-category-special-2": "<div class=\"themevale_sectionChild padding-top-20\">\r\n    <div class=\"themevale_sectionChild\">\r\n    {{#each categories}}\r\n        {{#if id '==' ../category_id}}\r\n            <div class=\"themevale_productsByCategoryspecial\">\r\n                <div class=\"themevale_page-heading-wrapper layout-2\">\r\n                    <h2 class=\"page-heading\">{{name}}</h2>\r\n                    <a class=\"themevale_link custom\" href=\"{{url}}\">View More</a>\r\n                </div>\r\n                <div class=\"themevale_content\">\r\n                    <div class=\"themevale_productsByCategoryspecial_wrapper\">\r\n                        <div class=\"sub_category\">\r\n                            <ul class=\"sub_category-list\">\r\n                                {{#each children}}\r\n                                    <li class=\"sub_category-item\">\r\n                                        <a class=\"sub_category-action\" href=\"{{url}}\">{{name}}</a>\r\n                                    </li>\r\n                                {{/each}}\r\n                            </ul>\r\n                        </div>\r\n                        <div class=\"marketting-banner\">\r\n                            <div class=\"marketting-banner-carousel\" \r\n                                data-slick='{\r\n                                    \"dots\": true,\r\n                                    \"arrows\": false,\r\n                                    \"slidesToShow\": 1,\r\n                                    \"slidesToScroll\": 1,\r\n                                    \"autoplay\": true,\r\n                                    \"infinite\": true,\r\n                                    \"autoplaySpeed\": 3000\r\n                                }'>\r\n                                {{#if ../../theme_settings.themevale_category-id-width-banner-2-image-1}}\r\n                           