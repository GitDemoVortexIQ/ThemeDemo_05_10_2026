s/brands-3.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=\"#\"><img class=\"lazyload\" src=\"https://caros-demo.mybigcommerce.com/content/loading.svg\" data-src=\"https://cdn11.bigcommerce.com/s-vfv3gnutke/product_images/uploaded_images/brands-4.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=\"#\"><img class=\"lazyload\" src=\"https://caros-demo.mybigcommerce.com/content/loading.svg\" data-src=\"https://cdn11.bigcommerce.com/s-vfv3gnutke/product_images/uploaded_images/brands-5.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=\"#\"><img class=\"lazyload\" src=\"https://caros-demo.mybigcommerce.com/content/loading.svg\" data-src=\"https://cdn11.bigcommerce.com/s-vfv3gnutke/product_images/uploaded_images/brands-6.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=\"#\"><img class=\"lazyload\" src=\"https://caros-demo.mybigcommerce.com/content/loading.svg\" data-src=\"https://cdn11.bigcommerce.com/s-vfv3gnutke/product_images/uploaded_images/brands-7.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=\"#\"><img class=\"lazyload\" src=\"https://caros-demo.mybigcommerce.com/content/loading.svg\" data-src=\"https://cdn11.bigcommerce.com/s-vfv3gnutke/product_images/uploaded_images/brands-8.png\" alt=\"\" /></a> \r\n                                </div>\r\n                                <div class=\"brand-item\">\r\n                                    <a href=