{"components/cavio/shop-collection":"<div class=\"shop-collection {{#if theme_settings.product_sale_badges '===' 'topleft'}}top-left-cavio{{/if}} {{#if theme_settings.product_sale_badges '===' 'sash'}}sash-cavio{{/if}} {{#if theme_settings.product_sale_badges '===' 'burst'}}burst-cavio{{/if}} {{#if theme_settings.product_sold_out_badges '===' 'none'}}none-stock-msg{{/if}} {{#if theme_settings.product_sold_out_badges '===' 'topleft'}}top-left-stock-msg{{/if}} {{#if theme_settings.product_sold_out_badges '===' 'sash'}}sash-stock-msg{{/if}} {{#if theme_settings.product_sold_out_badges '===' 'burst'}}burst-stock-msg{{/if}} {{#if settings.show_wishlist}}{{else}}hide-wishlist{{/if}}\">\n    {{#if theme_settings.shop_collection_image}}\n        <div class=\"collection-image-wraper\">\n            <a href=\"{{theme_settings.shop_collection_button_link}}\" class=\"collection-link\">\n                <img class=\"collection-image lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{settings.request.origin}}/images/stencil/original/image-manager/{{theme_settings.shop_collection_image}}\" alt=\"{{theme_settings.shop_collection_heading}}\" title=\"{{theme_settings.shop_collection_heading}}\">\n                <div class=\"overlay-category-banner\">\n                    <span class=\"read-more\">{{theme_settings.over-txt}}</span>\n                </div>\n                <div class=\"collection-info-wrapper collection-info-wrapper-mobile\">\n                    {{#if theme_settings.shop_collection_subheading}}\n                        <p class=\"collection-subheading\">{{theme_settings.shop_collection_subheading}}</p>\n                    {{/if}}\n                    {{#if theme_settings.shop_collection_heading}}\n                        <h2 class=\"collection-heading\">{{theme_settings.shop_collection_heading}}</h2>\n                    {{/if}}\n                    {{#if theme_settings.shop_collection_button_link}}\n                        <span class=\"button button--primary\">{{theme_settings.col-btn}}</span>\n                    {{/if}}\n                </div>                \n            </a>\n        </div>\n    {{/if}}\n    <div class=\"collection-information hide-pagination {{#if theme_settings.show_swatches '===' true}}{{else}}hide-swatches{{/if}}\">\n        <div class=\"collection-info-wrapper collection-info-wrapper-desktop\">\n            {{#if theme_settings.shop_collection_subheading}}\n                <p class=\"collection-subheading\">{{theme_settings.shop_collection_subheading}}</p>\n            {{/if}}\n            {{#if theme_settings.shop_collection_heading}}\n                <h2 class=\"collection-heading\">{{theme_settings.shop_collection_heading}}</h2>\n            {{/if}}\n            {{#if theme_settings.shop_collection_button_link}}\n                <a href=\"{{theme_settings.shop_collection_button_link}}\" class=\"button button--primary\">{{theme_settings.col-btn}}</a>\n            {{/if}}\n        </div>\n        <div class=\"collection-nav\">\n            <div class=\"slider-info\">\n              <span class=\"current-slide\"> </span> / <span class=\"total-slides\"> </span>\n            </div>\n            <div class=\"slider-arrows\">\n                <button type=\"button\" aria-label=\"Previous Slide\" class=\"slick-prev\"><svg><use href=\"#icon-cavio_angle-left\"></use></svg></button>\n                <button type=\"button\" aria-label=\"Next Slide\" class=\"slick-next\"><svg><use href=\"#icon-cavio_angle-right\"></use></svg></button>\n            </div> \n        </div>\n        {{#if theme_settings.shop_collection_product_ids}}\n            <div class=\"collection_products_list\" style=\"display: none\">\n                {{#each (split theme_settings.shop_collection_product_ids ',')}}\n                    <li class=\"product\">\n                        <article class=\"card\" data-product-id=\"{{trim this}}\">\n                        </article>\n                    </li>\n                {{/each}}\n            </div>\n            <div class=\"collection-loader\">\n                <img src=\"{{cdn 'img/loading.svg'}}\" alt=\"Loading content\">\n            </div>\n        {{/if}}\n    </div>\n</div>\n"}
