{
  "components/common/navigation-dropdownMobile": "<div class=\"navPage-subMenu navPage-subMenu-horizontal\" id=\"navPages2-{{id}}\" aria-hidden=\"true\" tabindex=\"-1\">\r\n    <ul class=\"navPage-subMenu-list\">\r\n        <li class=\"navPage-subMenu-item-child\">\r\n            <p class=\"navPage-subMenu-action navPages-action navPage-subMenu-title\">\r\n                <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                    <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                    <span>back</span>\r\n                </span>\r\n                <a class=\"text\" href=\"{{url}}\">{{name}}</a>\r\n            </p>\r\n        </li>\r\n        {{#each children}}\r\n            <li class=\"navPage-subMenu-item-child\">\r\n                {{#if children}}\r\n                    <p class=\"navPage-subMenu-action navPages-action navPages-action-depth-max has-subMenu\">\r\n                        <a class=\"text\" href=\"{{url}}\">{{name}}</a>\r\n                        <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                        </span>\r\n                    </p>\r\n                    {{> components/common/navigation-dropdownMobile}}\r\n                {{else}}\r\n                    <a class=\"navPage-subMenu-action navPages-action navPages-action-end\" href=\"{{url}}\"><span class=\"text\">{{name}}</span></a>\r\n                {{/if}}\r\n            </li>\r\n        {{/each}}\r\n    </ul>\r\n</div>\r\n"
}
