{"components/cavio/cavio-navigation-list-alternate":"{{#if categories}}\r\n    <div class=\"navPage-subMenu navPage-subMenu-mega-menu\" aria-hidden=\"true\" tabindex=\"-1\">\r\n        <div class=\"shop-nav-top\">\r\n        <a href=\"javascript:void(0)\" class=\"close-menu-cavio\"><svg><use href=\"#icon-close\"></use></svg>            \r\n        </a>            \r\n            <div class=\"shop-nav-title\">\r\n                <span>{{lang 'alternate-navigation-menu.label'}}</span>\r\n            </div>\r\n            {{#if customer}}\r\n                    <div class=\"create-account-top\">\r\n                        <a href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\r\n                    </div>         \r\n            {{else}}\r\n                {{#if settings.account_creation_enabled}}\r\n                    <div class=\"create-account-top\">\r\n                        <a href=\"{{urls.auth.create_account}}\">{{lang 'common.sign_up'}}</a>\r\n                        <span>|</span>\r\n                        <a href=\"{{urls.auth.login}}\">{{lang 'common.login'}}</a>\r\n                    </div>\r\n                {{/if}}\r\n            {{/if}}                \r\n        </div>\r\n        <div class=\"nav-shop-mega-menu-wrapper\">\r\n            <ul class=\"navPage-subMenu-list\">\r\n                {{#each categories}}\r\n                {{#if this.name '==' ../theme_settings.category-name-of-category-filter}}\r\n                {{else}}\r\n                    <li class=\"navPage-subMenu-item aa\">\r\n                        {{#if children}}\r\n                            <div class=\"nav-menu-title-wrapper\">\r\n                                <a class=\"navPage-subMenu-action navPages-action has-subMenu{{#if is_active}} activePage{{/if}}\"\r\n                                   href=\"{{url}}\"\r\n                                   aria-label=\"{{name}}\"\r\n                                >\r\n                                    <span class=\"nav-category-title\">{{name}}</span>\r\n                                    <span class=\"collapsible-icon-wrapper\"\r\n                                        data-collapsible=\"navPages-{{id}}\"\r\n                                        data-collapsible-disabled-breakpoint=\"medium\"\r\n                                        data-collapsible-disabled-state=\"closed\"\r\n                                        data-collapsible-enabled-state=\"closed\"\r\n                                    > \r\n                                    <svg><use href=\"#icon-cavio_angle-right\" /></svg>\r\n                                    </span>\r\n                                </a>\r\n                                <span class=\"collapsible-icon-wrapper-cavio-mobile\"> \r\n                                    <svg><use href=\"#icon-cavio_angle-right\" /></svg>\r\n                                </span>     \r\n                            </div>\r\n                            <div class=\"navPage-childList navPage-child-second-level\" id=\"navPages-{{id}}\">\r\n                                <div class=\"category-level-title\">\r\n                                    <h3>{{name}}</h3>\r\n                                    <a href=\"{{url}}\" class=\"button category-shop-button\">{{lang 'alternate-navigation-menu.shop_all'}}</a>\r\n                                </div>\r\n                                <ul class=\"navPage-childList-list\">\r\n                                    {{#each children}}\r\n                                    <li class=\"navPage-childList-item navPage-second-child-item\">\r\n                                        <a class=\"navPage-childList-action navPage-second-level-action navPages-action{{#if is_active}} activePage{{/if}}\"\r\n                                           href=\"{{url}}\"\r\n                                           aria-label=\"{{name}}\"\r\n                                        >\r\n                                            {{name}}\r\n                                        </a>\r\n                                        {{#if children}}\r\n                                        <span class=\"collapsible-icon-wrapper-cavio-mobile\"> \r\n                                            <svg><use href=\"#icon-cavio_angle-right\" /></svg>\r\n                                        </span>    \r\n                                        {{/if}}                                         \r\n                                        {{#if children}}\r\n                                            <ul class=\"navPage-childList navPage-third-child-list\" id=\"navPages-{{id}}\">\r\n                                                {{#each children}}\r\n                                                <li class=\"navPage-childList-item\">\r\n                                                    <a class=\"navPage-childList-action navPage-third-level-action navPages-action{{#if is_active}} activePage{{/if}}\"\r\n                                                       href=\"{{url}}\"\r\n                                                       aria-label=\"{{name}}\"\r\n                                                    >\r\n                                                        {{name}}\r\n                                                    </a>\r\n                                                </li>\r\n                                                {{/each}}\r\n                                            </ul>\r\n                                        {{/if}}\r\n                                    </li>\r\n                                    {{/each}}\r\n                                </ul>\r\n                            </div>\r\n                        {{else}}\r\n                            <a class=\"navPage-subMenu-action navPages-action{{#if is_active}} activePage{{/if}}\"\r\n                               href=\"{{url}}\"\r\n                               aria-label=\"{{name}}\"\r\n                            >\r\n                                {{name}}\r\n                            </a>\r\n                        {{/if}}\r\n                    </li>\r\n                {{/if}}\r\n                {{/each}}\r\n                {{#if shop_by_brand.length}}\r\n                <li class=\"navPage-subMenu-item aa\">\r\n                    <div class=\"nav-menu-title-wrapper\">\r\n                        <a class=\"navPage-subMenu-action navPages-action has-subMenu{{#if is_active}} activePage{{/if}}\"\r\n                            href=\"{{urls.brands}}\"\r\n                            aria-label=\"brands-menu\"\r\n                        >\r\n                            <span class=\"nav-category-title\">{{lang 'brand.label'}}</span>\r\n                            <span class=\"collapsible-icon-wrapper\"\r\n                                data-collapsible=\"navPages-{{id}}\"\r\n                                data-collapsible-disabled-breakpoint=\"medium\"\r\n                                data-collapsible-disabled-state=\"closed\"\r\n                                data-collapsible-enabled-state=\"closed\"\r\n                            > \r\n                            <svg><use href=\"#icon-cavio_angle-right\" /></svg>\r\n                            </span>\r\n                        </a>\r\n                        <span class=\"collapsible-icon-wrapper-cavio-mobile\"> \r\n                            <svg><use href=\"#icon-cavio_angle-right\" /></svg>\r\n                        </span>     \r\n                    </div>\r\n                    <div class=\"navPage-childList navPage-child-second-level brand-mega-menu\" id=\"navPages-brands-menu\">\r\n                        <div class=\"category-level-title\">\r\n                            <h3>{{lang 'brand.label'}}</h3>\r\n                            <a href=\"{{urls.brands}}\" class=\"button category-shop-button\">{{lang 'alternate-navigation-menu.shop_all'}}</a>\r\n                        </div>\r\n                        <ul class=\"navPage-childList-list\">\r\n                            {{#each shop_by_brand}}\r\n                            <li class=\"navPage-childList-item navPage-second-child-item\">\r\n                                <a class=\"navPage-childList-action navPage-second-level-action navPages-action{{#if is_active}} activePage{{/if}}\"\r\n                                    href=\"{{url}}\"\r\n                                    aria-label=\"{{name}}\"\r\n                                >\r\n                                    {{name}}\r\n                                </a>\r\n                            </li>\r\n                            {{/each}}\r\n                        </ul>\r\n                    </div>\r\n                </li>\r\n                {{/if}}                \r\n            </ul>\r\n            <ul class=\"shop-nav-info-list\">\r\n                {{#if settings.gift_certificates_enabled}}\r\n                <li>\r\n                    <a href=\"{{urls.gift_certificate.purchase}}\"><span class=\"navUser-custom-icon navUser--gift-icon\"><svg><use xlink:href=\"#icon-cavio-gitftcertificate\"></use></svg></span> \r\n                        <span class=\"shop-nav-info-label\">{{lang 'common.gift_cert'}}</span>\r\n                    </a>\r\n                </li>\r\n                {{/if}}\r\n                {{#if settings.show_wishlist}}\r\n                <li>\r\n                    <a href=\"{{urls.account.wishlists.all}}\"><span class=\"navUser-custom-icon navUser--wishlist-icon\"><svg><use xlink:href=\"#icon-cavio_heart\"></use></svg></span> <span class=\"shop-nav-info-label\"><span class=\"shop-nav-info-label\">{{lang 'common.wish_list'}}</span>\r\n                    </a>\r\n                </li>\r\n                {{/if}}\r\n                {{#if theme_settings.hot-deals}}\r\n                <li>\r\n                    <a href=\"{{theme_settings.hot-deals-url}}\"><span class=\"navUser-custom-icon navUser--fire-icon\"><svg><use xlink:href=\"#icon-cavio-fire\"></use></svg></span> <span class=\"shop-nav-info-label\">{{theme_settings.hot-deals}}</span></a>\r\n                </li>\r\n                {{/if}}   \r\n                {{#if theme_settings.clearance-url}} \r\n                <li>\r\n                    <a href=\"{{theme_settings.clearance-url}}\"><span class=\"navUser-custom-icon navUser--clearance-icon\"><svg><use xlink:href=\"#icon-clearance-icon\"></use></svg></span> <span class=\"shop-nav-info-label\">{{theme_settings.clearance}}</span></a>\r\n                </li>\r\n                {{/if}}   \r\n            </ul>\r\n        </div>\r\n    </div>\r\n{{/if}}\r\n"}
