{"components/faceted-search/selected-facets":"<div class=\"facetedSearch-refineFilters sidebarBlock\">\n    {{#if items}}\n        <ul class=\"inlineList inlineList--labels\">\n            {{#each items}}\n                <li>\n                    <a href=\"{{url}}\"\n                       class=\"facetLabel\"\n                       rel=\"nofollow\"\n                       data-faceted-search-facet\n                    >\n                        {{#if facet '===' 'rating'}}\n                            {{lang 'search.faceted.selected.rating-label' rating=title}}\n                        {{else}}\n                            {{{sanitize title}}}\n                        {{/if}}\n\n                        <svg class=\"icon\">\n                            <use href=\"#icon-close\" />\n                        </svg>\n                    </a>\n                </li>\n            {{/each}}\n        </ul>\n    {{else}}\n        <p>{{lang 'search.faceted.selected.no-filters'}}</p>\n    {{/if}}\n    <div class=\"bottom-buttons-filter filter-buttons\">\n        {{#if remove_all_url}}\n            <a href=\"{{remove_all_url}}\"  class=\"button remove-all-button\" data-faceted-search-facet>\n                {{lang 'search.faceted.selected.clear-all'}}\n            </a>\n        {{/if}}\n        <a href=\"javascript:void(0)\" class=\"filter-visibility-button\">\n            <svg class=\"icon\"><use xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"#icon-cavio_filter\"></use></svg>\n            <span class=\"visible-filter\">Show Filters</span>\n            <span class=\"hide-filter\">Hide Filters</span>\n        </a>\n    </div>\n</div>\n"}
