{"components/cavio/homepage-instagram":"<div class=\"hp-instagram hide-pagination\">\n    <div class=\"insta-post-title\">\n        {{#if theme_settings.instagram-title}}\n            <h2 class=\"hp-section-title\">{{theme_settings.instagram-title}}</h2>\n        {{/if}}\n        {{#if theme_settings.instagram-description-text}}\n            <p class=\"hp-section-description\">{{theme_settings.instagram-description-text}} <a href=\"{{theme_settings.instagram-link}}\" class=\"instagram-link\" target=\"_blank\">{{theme_settings.instagram-link-text}}</a></p>\n        {{/if}}\n    </div>\n    {{#if theme_settings.instagram-access-token}}\n        <div class=\"insta-post-nav\" style=\"display:none;\">\n            <div class=\"slider-info\">\n              <span class=\"current-slide\"> </span> / <span class=\"total-slides\"> </span>\n            </div>\n            <div class=\"slider-arrows\">\n                <button type=\"button\" class=\"slick-prev\"><svg><use href=\"#icon-cavio_angle-left\"></use></svg></button>\n                <button type=\"button\" class=\"slick-next\"><svg><use href=\"#icon-cavio_angle-right\"></use></svg></button>\n            </div>\n        </div>\n        <div class=\"instagram-grid\" style=\"display:none;\">\n            <div class=\"instagram-post\">\n                                                   \n            </div>    \n        </div>\n    {{/if}}\n</div>\n"}
