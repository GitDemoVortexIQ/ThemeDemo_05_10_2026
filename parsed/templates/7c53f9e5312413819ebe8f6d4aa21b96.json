{"components/common/navigation":"<nav class=\"navUser\">\n    <ul class=\"navUser-section navUser-section--alt\">\n        {{#if customer.store_credit.value '>' 0}}\n            <li class=\"navUser-item navUser-action-store-Credit\">\n                <a class=\"navUser-action navUser-action--storeCredit\"\n                   data-dropdown=\"storeCredit-dropdown\"\n                   data-options=\"align:bottom\"\n                   href=\"{{urls.cart}}\"\n                   aria-label=\"{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\"\n                >\n                    <span class=\"navUser-action-divider\">\n                        {{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\n                    </span>\n                </a>\n                <div class=\"dropdown-menu\" id=\"storeCredit-dropdown\" data-dropdown-content aria-hidden=\"true\">\n                    {{{lang 'common.store_credit' store_credit=customer.store_credit.formatted}}}\n                </div>\n            </li>\n        {{/if}}\n        <li class=\"navUser-item\">\n            <a class=\"navUser-action navUser-item--compare\"\n               href=\"{{urls.compare}}\"\n               data-compare-nav\n               aria-label=\"{{lang 'common.compare'}}\"\n            >\n                {{lang 'common.compare'}} <span class=\"countPill countPill--positive countPill--alt\"></span>\n            </a>\n        </li>\n        <li class=\"navUser-item navUser-item--search\">\n            {{#if theme_settings.searchlayout '==' 'SearchLayout1'}}\n                <button class=\"navUser-action navUser-action--quickSearch\"\n                   type=\"button\"\n                   id=\"quick-search-expand\"\n                   data-search=\"quickSearch\"\n                   aria-controls=\"quickSearch\"\n                   aria-label=\"{{lang 'common.search'}}\"\n                >\n                    <svg><use xlink:href=\"#icon-cavio_search\"></use></svg>\n                </button>\n            {{else}}\n                <button class=\"navUser-action navUser-action--quickSearch navUser-action--quicksearch-mobile\">\n                    <svg><use xlink:href=\"#icon-cavio_search\"></use></svg>\n                </button>\n                <div class=\"dropdown search-popup-disable dropdown--quickSearch dropdown--quickSearch-menu is-open f-open-dropdown\" id=\"quickSearch\" aria-hidden=\"false\" data-prevent-quick-search-close>\n                    {{> components/common/quick-search name='nav-quick-search'}}\n                </div>\n            {{/if}}            \n        </li>\n        {{#if settings.show_wishlist}}\n            <li class=\"navUser-item navUser-item--wishlist\">\n                <a class=\"navUser-action navUser-action--wishlist\"\n                   href=\"{{urls.account.wishlists.all}}\"\n                   aria-label=\"{{lang 'common.wish_list'}}\"\n                >\n                    <svg><use xlink:href=\"#icon-cavio_heart\"></use></svg>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navUser-item navUser-item--account\">\n            <a class=\"navUser-action navUser-action--account\" data-dropdown=\"cart-preview-account-dropdown\" \n               href=\"{{urls.auth.login}}\"\n               aria-label=\"{{lang 'common.login'}}\"\n            >\n                <svg><use xlink:href=\"#icon-cavio_profile\"></use></svg>\n            </a>            \n            \n            <div class=\"navUser-dropdown dropdown-menu navCavio-dropdown\" id=\"cart-preview-account-dropdown\" data-dropdown-content aria-hidden=\"true\">\n                {{#if customer}}\n                <ul class=\"navUser-list\">\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.orders.all}}\"\n                           aria-label=\"{{lang 'account.nav.orders'}}\"\n                        >\n                            {{lang 'account.nav.orders'}}\n                        </a>\n                    </li>\n                    {{#if settings.returns_enabled}}\n                        <li class=\"navUser-item\">\n                            <a class=\"navUser-action\"\n                               href=\"{{urls.account.returns}}\"\n                               aria-label=\"{{lang 'account.nav.returns'}}\"\n                            >\n                                {{lang 'account.nav.returns'}}\n                            </a>\n                        </li>\n                    {{/if}}\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.inbox}}\"\n                           aria-label=\"{{lang 'account.mobile_nav.messages'}}\"\n                        >\n                            {{lang 'account.mobile_nav.messages'}}\n                        </a>\n                    </li>\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.addresses}}\"\n                           aria-label=\"{{lang 'account.nav.addresses'}}\"\n                        >\n                            {{lang 'account.nav.addresses'}}\n                        </a>\n                    </li>\n                    {{#if settings.show_payment_methods}}\n                        <li class=\"navUser-item\">\n                            <a class=\"navUser-action\"\n                               href=\"{{urls.account.payment_methods.all}}\"\n                               aria-label=\"{{lang 'account.nav.payment_methods'}}\"\n                            >\n                                {{lang 'account.nav.payment_methods'}}\n                            </a>\n                        </li>\n                    {{/if}}\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.wishlists.all}}\"\n                           aria-label=\"{{lang 'account.mobile_nav.wishlists'}}\"\n                        >\n                            {{lang 'account.mobile_nav.wishlists'}}\n                        </a>\n                    </li>\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.recent_items}}\"\n                           aria-label=\"{{lang 'account.nav.recently_viewed'}}\"\n                        >\n                            {{lang 'account.nav.recently_viewed'}}\n                        </a>\n                    </li>\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.account.details}}\"\n                           aria-label=\"{{lang 'account.nav.settings'}}\"\n                        >\n                            {{lang 'account.nav.settings'}}\n                        </a>\n                    </li>                   \n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.auth.logout}}\"\n                           aria-label=\"{{lang 'common.logout'}}\"\n                        >\n                            {{lang 'common.logout'}}\n                        </a>\n                    </li>\n                </ul>\n                {{else}}\n                <ul class=\"navUser-list\">\n                    <li class=\"navUser-item\">\n                        <a class=\"navUser-action\"\n                           href=\"{{urls.auth.login}}\"\n                           aria-label=\"{{lang 'common.login'}}\"\n                        >\n                            {{lang 'common.login'}}\n                        </a>                        \n                    </li>\n                    {{#if settings.account_creation_enabled}}\n                        <li class=\"navUser-item\">\n                            <a class=\"navUser-action\"\n                               href=\"{{urls.auth.create_account}}\"\n                               aria-label=\"{{lang 'common.sign_up'}}\"\n                            >\n                                {{lang 'common.sign_up'}}\n                            </a>\n                        </li>\n                    {{/if}}                        \n                </ul>\n                {{/if}}\n            </div>\n            \n        </li>\n        <li class=\"navUser-item navUser-item--cart\">\n            <a class=\"navUser-action\"\n               data-cart-preview\n               data-dropdown=\"cart-preview-dropdown\"\n               data-options=\"align:right\"\n               href=\"{{urls.cart}}\"\n               aria-label=\"{{lang 'cart.nav_aria_label'}}\"\n            >\n                <span class=\"navUser-item-cartLabel\"><svg><use xlink:href=\"#icon-cavio_cart\"></use></svg></span>\n                <span class=\"countPill cart-quantity\"></span>\n            </a>\n\n            <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" data-dropdown-content aria-hidden=\"true\"></div>\n        </li>\n    </ul>\n    {{#if theme_settings.searchlayout '==' 'SearchLayout1'}}\n    <div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" data-prevent-quick-search-close>\n        {{> components/common/quick-search name='nav-quick-search'}}\n    </div>\n    {{/if}}\n</nav>\n","components/common/quick-search":"<div class=\"container\">\n    <div class=\"quick-search-buttons\">\n        <div class=\"recent-search-box quickResults-item\">\n            <div class=\"recent-history-title\">\n                <span class=\"quickResults-item-heading\">{{lang 'common.recent_label'}}</span>\n                <span class=\"clear-all-recent\">{{lang 'search.clear_recent'}}</span>\n            </div>\n            <ul class=\"productGrid-search\">\n            </ul>\n        </div>\n        <div class=\"populer-search-box quickResults-item\">\n            <span class=\"quickResults-item-heading\">{{lang 'common.popular_label'}}</span>\n            <ul class=\"productGrid-search\">\n                {{#if theme_settings.pop-search-label-1}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-1}}\">{{theme_settings.pop-search-label-1}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-2}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-2}}\">{{theme_settings.pop-search-label-2}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-3}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-3}}\">{{theme_settings.pop-search-label-3}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-4}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-4}}\">{{theme_settings.pop-search-label-4}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-5}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-5}}\">{{theme_settings.pop-search-label-5}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n\n                {{#if theme_settings.pop-search-label-6}}\n                    <li>\n                        <a href=\"{{theme_settings.pop-search-label-link-6}}\">{{theme_settings.pop-search-label-6}}</a>\n                        <span aria-hidden=\"true\" class=\"delet-search\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </li>\n                {{/if}}\n            </ul>\n        </div>        \n    </div>\n    <div class=\"search-box-cavio\">\n        <div class=\"search-label-box\">\n            <span class=\"search-cavio-label\"> {{lang 'common.search_text'}}</span>\n            {{#if theme_settings.searchlayout '==' 'SearchLayout1'}} \n                <div class=\"search-close-button\">\n                    <button class=\"modal-close\"\n                        type=\"button\"\n                        title=\"{{lang 'common.close_search'}}\"\n                        data-drop-down-close\n                    >\n                        <span class=\"aria-description--search\">{{lang 'common.close_search'}}</span>\n                        <span aria-hidden=\"true\" class=\"icon--search-close\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </button>\n                </div>\n            {{else}} \n                <div class=\"search-close-button\">\n                    <button class=\"modal-close layout-two-close\"\n                        type=\"button\"\n                        title=\"{{lang 'common.close_search'}}\"\n                    >\n                        <span class=\"aria-description--search\">{{lang 'common.close_search'}}</span>\n                        <span aria-hidden=\"true\" class=\"icon--search-close\">\n                            <svg><use xlink:href=\"#icon-close\"></use></svg>\n                        </span>\n                    </button>\n                </div>            \n            {{/if}}\n\n        </div>\n        <form class=\"form\" onsubmit=\"return false\" data-url=\"{{urls.search}}\" data-quick-search-form>\n            <fieldset class=\"form-fieldset\">\n                <div class=\"form-field\">\n                    <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                    <input class=\"form-input\"\n                           data-search-quick\n                           name=\"{{name}}\"\n                           id=\"{{name}}\"\n                           data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                           placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                           autocomplete=\"off\"\n                    >\n                    <svg class=\"cavio-input-icon\"><use xlink:href=\"#icon-cavio_search\"></use></svg>\n                </div>\n            </fieldset>\n        </form>\n        <div class=\"quick-search-result-wrapper\">\n        <section class=\"quickSearchResults desktop-search hide-pagination\" data-bind=\"html: results\"></section>\n        </div>\n        <p role=\"status\"\n           aria-live=\"polite\"\n           class=\"aria-description--hidden\"\n           data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n        ></p>        \n    </div>\n    <section class=\"quickSearchResults mobile-search hide-pagination\" data-bind=\"html: results\"></section>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n"}
