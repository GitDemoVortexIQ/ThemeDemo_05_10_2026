{"components/cavio/products-finder":"{{#each categories}}\n    {{#if this.name '==' ../theme_settings.category-name-of-category-filter}}\n        <span class=\"filter-first-category-id is-srOnly\">{{id}}</span>\n    {{/if}}\n{{/each}}\n<div class=\"vch-view\">\n    <div class=\"title\" id=\"reveal-btn\">\n        <span>{{theme_settings.button-text}}</span>\n        <i class=\"down-icon-category-filter\"><svg><use href=\"#icon-cavio_expand-down\"></use></svg></i>\n    </div>\n</div>\n<div class=\"vch-main hidden-section\">\n    <div class=\"vch-filter\">\n        <div class=\"form-wrapper-vch\">\n            <div class=\"form-field\">\n                <select id=\"vch-level-1\" class=\"form-select\">\n                    <option selected=\"\" disabled=\"\" data-default-selection=\"{{theme_settings.drop-label-1}}\" >{{theme_settings.drop-label-1}}</option>\n                </select>\n                <i class=\"down-icon-select-filter\"><svg><use href=\"#icon-cavio_expand-down\"></use></svg></i>\n            </div>\n            <div class=\"form-field\">\n                <select id=\"vch-level-2\" class=\"form-select\">\n                    <option selected=\"\" disabled=\"\" data-default-selection=\"{{theme_settings.drop-label-2}}\" >{{theme_settings.drop-label-2}}</option>\n                </select>\n                <i class=\"down-icon-select-filter\"><svg><use href=\"#icon-cavio_expand-down\"></use></svg></i>                \n            </div>\n            <div class=\"form-field\">\n                <select id=\"vch-level-3\" class=\"form-select\">\n                    <option selected=\"\" disabled=\"\" data-default-selection=\"{{theme_settings.drop-label-3}}\" >{{theme_settings.drop-label-3}}</option>\n                </select>\n                <i class=\"down-icon-select-filter\"><svg><use href=\"#icon-cavio_expand-down\"></use></svg></i>            \n            </div>\n        </div>\n        <div class=\"group-button\">\n            <a class=\"button button--primary srch-btn\" id=\"vch-select-search\" title=\"Search\"><span>{{lang 'category_filter.category_filter_button'}}</span></a>\n        </div>\n        <div class=\"buttons \" id=\"reset-filters\">\n            <span class=\"vch-reset\">\n                <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 32 32\">\n                    <path d=\"M0 2.6l13.4 13.4-13.4 13.3 2.6 2.6 13.4-13.4 13.4 13.4 2.6-2.6-13.4-13.4 13.4-13.4-2.6-2.5-13.4 13.4-13.3-13.4-2.7 2.6z\"></path>\n                </svg>\n            </span>\n            <span class=\"vch-change\">{{lang 'category_filter.reset_category_filter'}}</span>\n        </div>        \n    </div>\n</div>\n"}
