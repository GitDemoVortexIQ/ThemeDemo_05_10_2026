{"components/cavio/homepage-recent-blogs":"{{#if blog.recent_posts}}\n    <div class=\"hp-recent-blogs hide-pagination\">\n        <div class=\"blog-content{{#if theme_settings.show_hp_blog_images}} show-blog-img{{/if}}\">\n            <div class=\"recent-post-title\">\n                <h2 class=\"hp-section-title\">{{theme_settings.blog-title}}</h2>\n                <p class=\"hp-section-description\">{{theme_settings.blog-sub-text}}</p>\n            </div>\n            <div class=\"recentpost-nav\">\n                <div class=\"slider-info\">\n                  <span class=\"current-slide\"> </span> / <span class=\"total-slides\"> </span>\n                </div>\n                <div class=\"slider-arrows\">\n                    <button type=\"button\" aria-label=\"Previous Slide\" class=\"slick-prev\"><svg><use href=\"#icon-cavio_angle-left\"></use></svg></button>\n                    <button type=\"button\" aria-label=\"Next Slide\" class=\"slick-next\"><svg><use href=\"#icon-cavio_angle-right\"></use></svg></button>\n                </div> \n            </div>\n            <div class=\"blog-grid\">\n                {{#each blog.recent_posts}}\n                    <div class=\"blog-post\">\n                        <div class=\"blog-post-wrapper\">\n                            <a class=\"recent-blog-card\" href=\"{{url}}\">\n                                <div class=\"blog-thumb-img\">\n                                    <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{#if thumbnail}}{{getImage thumbnail}}{{else}}{{cdn 'img/ProductDefault.gif'}}{{/if}}\" alt=\"{{#if thumbnail.alt}}{{thumbnail.alt}}{{else}}Blog Image{{/if}}\" alt=\"{{description}}\" title=\"{{description}}\">\n                                    <div class=\"overlay-blog\">\n                                        <span class=\"read-more\">{{lang 'blog.read_more_button'}}</span>\n                                    </div>\n                                </div>\n                                <div class=\"blog-details\">\n                                    <h3 class=\"blog-title\">{{title}}</h3>\n                                    <p>{{{ellipsis summary 80}}}</p>\n                                </div>\n                            </a>\n                        </div>\n                    </div>\n                {{/each}}\n            </div>\n        </div>\n    </div>\n{{/if}}\n"}
