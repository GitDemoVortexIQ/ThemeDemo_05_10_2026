{
  "components/themevale/footer/footer-3": "<footer class=\"footer footer-layout-3\">\r\n    <div class=\"themevale_middleFooter\">\r\n        <div class=\"container\">\r\n            <div class=\"footer-info themevale_footer-info\">\r\n                <div class=\"footer-info-col footer-dropdownmobile\" data-section-type=\"footer-webPages\">\r\n                    <h5 class=\"footer-info-heading\">Wood Workers Workshop</h5>\r\n                    <ul class=\"footer-info-list\">\r\n                        <!--<li class=\"store-address\"><svg class=\"icon\"><use xlink:href=\"#icon-location-2\"></use></svg>{{nl2br settings.address}}</li>-->\r\n                        <li class=\"store-phone\"><svg class=\"icon\"><use xlink:href=\"#icon-telephone\"></use></svg><p><a href=\"tel:{{settings.phone_number}}\">{{settings.phone_number}}</a></p><a class=\"ask_an_expert button button--transparent\" href=\"/contact-us/\" >Ask an Expert</a></li>\r\n                        <li class=\"store-email\"><img src=\"/product_images/uploaded_images/envelope-2.png\" style=\"margin-left: -32px; padding-right: 14px;\" alt=\"\"/><a href=\"mailto:sales@woodworkersworkshop.co.uk\">sales@woodworkersworkshop.co.uk</a></li>\r\n                        <li>\r\n                            \r\n                            {{> components/common/social-links}} \r\n                            \r\n                       \r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n                <div class=\"footer-info-col footer-info-col--small footer-dropdownmobile\" data-section-type=\"footer-categories\">\r\n                    <h5 class=\"footer-info-heading\">{{lang 'footer.shop'}}</h5>\r\n                    <ul class=\"footer-info-list\">\r\n                        <li>\r\n                            <a href=\"/\">Home</a>\r\n                        </li>\r\n                        <li>\r\n                            <a href=\"/search.php?section=content\">Search</a>\r\n                        </li>\r\n                        <li>\r\n                            <a href=\"/about-us/\">About Us</a>\r\n                        </li>\r\n\t\t\t\t\t\t<li>\r\n                            <a href=\"/blog/\">Blog</a>\r\n                        </li> \r\n                        <li>\r\n                            <a href=\"/brands/\">Brands</a>\r\n                        </li> \r\n                        <li><a href=\"/blog/tag/videos\">How to videos</a></li>\r\n                         <li><a href=\"/student-discount-scheme\">Student Discount</a></li>\r\n                        <!--<li>-->\r\n                        <!--    <a href=\"/ebay-outlet-store/\">eBay Outlet Store</a>-->\r\n                        <!--</li>-->\r\n                        <!--<li>-->\r\n                        <!--    <a href=\"https://www.peterseftonfurnitureschool.com/\" target=\"_blank\">Wood Working Courses</a>-->\r\n                        <!--</li>-->\r\n\t\t\t\t\t\t<li>\r\n                            <a href=\"/contact-us/\">Contact Us</a>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n                <div class=\"footer-info-col footer-info-col--small footer-dropdownmobile\">\r\n                    <h5 class=\"footer-info-heading\">{{lang 'footer.services'}}</h5>\r\n                    <ul class=\"footer-info-list\">\r\n                        <!--<li><a href=\"/covid-update/\">COVID-19 Update</a></li>-->\r\n                        <li><a href=\"/customer-service/\">Customer Service</a></li>\r\n                        <li><a href=\"/delivery-policy/\">Delivery </a></li>\r\n                        <li><a href=\"/returns-policy/\">Returns </a></li>\r\n                        <li><a href=\"/privacy-cookie-policy/\">Privacy & Cookie Policy</a></li>\r\n                        <li><a href=\"/company-info/\">Company Information </a></li>\r\n                        <li><a href=\"/terms-of-conditions/\">Terms & Conditions </a></li>                   \r\n                        <!--<li><a href=\"/blog/tag/videos\">How to videos</a></li>-->\r\n                    </ul>\r\n                </div>\r\n                <div class=\"footer-info-col\" data-section-type=\"newsletterSubscription\">\r\n                    <!--{{#if settings.show_newsletter_box}}-->\r\n                    <!--    {{> components/common/subscription-form}}-->\r\n                    <!--{{/if}}-->\r\n                     <div class=\"klaviyo-form-QZJsx9\"></div>\r\n                    <p style=\"padding-top:20px;\">We score <span class='jdgm-all-reviews-rating'></span> out of 5 based on <span class='jdgm-all-reviews-count'></span> reviews.</p>\r\n                    <div class=\"themevale_securityImage\">\r\n                        <ul>\r\n                            <li>\r\n                                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/security-5.png\" alt=\"\">\r\n                            </li>\r\n                            <li>\r\n                                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/security-2.png\" alt=\"\">\r\n                            </li>\r\n                            <li>\r\n                                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/security-3.png\" alt=\"\">\r\n                            </li>\r\n                            <li>\r\n                                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/security-4.png\" alt=\"\">\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                    \r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    </div>\r\n    <div class=\"themevale_bottomFooter\">\r\n        <div class=\"container\">\r\n            <ul class=\"themevale_navigation_footer\">\r\n                <!--<li>\r\n                    <a href=\"/faq\">FAQs</a>\r\n                </li>-->\r\n                <li>\r\n                    <a href=\"/account.php?action=order_status\">My Orders</a>\r\n                </li>\r\n                <li>\r\n                    <a href=\"/about-us/\">About Us</a>\r\n                </li>\r\n                <li>\r\n                    <a href=\"/blog/\">Blog</a>\r\n                </li>\r\n                 <li>\r\n                    <a href=\"/giftcertificates.php\">e-Gift Cards</a>\r\n                </li>\r\n            </ul>\r\n        </div>\r\n        <div class=\"container\">\r\n            <div class=\"item\">\r\n                {{#if theme_settings.show_copyright_footer}}\r\n                    <div class=\"footer-copyright\">\r\n                        <p class=\"powered-by\">Copyright &copy; {{moment format=\"YYYY\"}} {{settings.store_name}} </p>\r\n                    </div>\r\n                {{/if}}\r\n                {{#if theme_settings.show_powered_by}}\r\n                {{/if}}\r\n            </div>\r\n            <div class=\"item\">\r\n                {{> components/common/payment-icons}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</footer>\r\n\r\n{{#if theme_settings.themevale_ask_an_expert}}\r\n    {{#if theme_settings.themevale_homepage_layout '===' 'homepage layout 3'}}\r\n        {{> components/themevale/ask-an-expert}}\r\n    {{/if}}\r\n{{/if}}\r\n\r\n",
  "components/common/social-links": "{{#if social_media}}\n    <ul class=\"socialLinks socialLinks--alt\">\n     \n        {{#each social_media}}\n            <li class=\"socialLinks-item\">\n            {{#if display_name '===' 'facebook'}}\n                <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                     <img src=\"/product_images/uploaded_images/fb.png\" alt=\"\"/ width=\"11\">\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'twitter'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                     <svg><use xlink:href=\"#icon-twitter\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'linkedin'}}\n               <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-linkedin\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'google'}}\n               <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-google\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'google_plusone'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-google-plus\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'pinterest'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-pinterest\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'email'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-envelope\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'print'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-print\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'facebook_like'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-facebook_like\" /></svg>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'instagram'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <img src=\"/product_images/uploaded_images/instagram.png\" alt=\"\"/>\n                </a>\n            {{/if}}\n            \n            {{#if display_name '===' 'youtube'}}\n                 <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    <svg><use xlink:href=\"#icon-youtube\" /></svg>\n                </a>\n            {{/if}}\n            \n           </li>\n        {{/each}}\n        <li class=\"socialLinks-item\">\n            <a class=\"icon\" href=\"mailto:sales@woodworkersworkshop.co.uk\" rel=\"noopener\">\n                <svg><use xlink:href=\"#icon-envelope\"/></svg>\n            </a>\n        </li>\n    </ul>\n{{/if}}\n",
  "components/common/subscription-form": "<h5 class=\"footer-info-heading\">{{lang 'newsletter.subscribe'}}</h5>\n<p>{{lang 'newsletter.subscribe_intro'}}</p>\n\n<form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\n    <fieldset class=\"form-fieldset\">\n        <input type=\"hidden\" name=\"action\" value=\"subscribe\">\n        <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\n        <input type=\"hidden\" name=\"check\" value=\"1\">\n        <div class=\"form-field\">\n            <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\n            <div class=\"form-prefixPostfix wrap\">\n                <input class=\"form-input\" id=\"nl_email\" name=\"nl_email\" type=\"email\" value=\"{{customer.email}}\" placeholder=\"{{lang 'newsletter.email_placeholder'}}\">\n                <input class=\"button button--primary form-prefixPostfix-button--postfix\" type=\"submit\" value=\"{{lang 'newsletter.subscribe_submit'}}\">\n            </div>\n            {{#if settings.show_newsletter_summary }}\n                <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\n            {{/if}}\n        </div>\n    </fieldset>\n</form>\n",
  "components/common/payment-icons": "{{#with theme_settings}}\n    {{#or show_accept_amex show_accept_discover show_accept_mastercard show_accept_paypal show_accept_visa show_accept_sage show_accept_wallet}}\n        <div class=\"payment-wrapper\">\n            {{#if show_accept_visa}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-1.png\" alt=\"payment-1\">\n            {{/if}}\n            {{#if show_accept_mastercard}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-2.png\" alt=\"payment-2\">\n            {{/if}}\n            {{#if show_accept_amex}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-3.png\" alt=\"payment-3\">\n            {{/if}}\n            <!--{{#if show_accept_discover}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-4.png\" alt=\"payment-4\">\n            {{/if}}-->\n            {{#if show_accept_paypal}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-5.png\" alt=\"payment-5\">\n            {{/if}}\n            <!--{{#if show_accept_sage}}\n                <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-6.png\" alt=\"payment-6\">\n            {{/if}}-->\n            <!--{{#if show_accept_wallet}}-->\n            <!--    <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-7.png\" alt=\"payment-7\">-->\n            <!--{{/if}}-->\n        </div>\n    {{/or}}\n{{/with}}\n",
  "components/themevale/ask-an-expert": "<!-- BEGIN ASK AN EXPERT MODAL -->\r\n<div id=\"ask-an-expert\" class=\"modal\" data-reveal>\r\n    <div class=\"modal-content\">\r\n        <div class=\"modal-header\">\r\n            <h2 class=\"modal-header-title\">{{theme_settings.themevale_ask_an_expert-popuptitle}}</h2>\r\n            <a href=\"#\" class=\"modal-close\" aria-label=\"{{lang 'common.close'}}\" role=\"button\">\r\n                <span aria-hidden=\"true\">&#215;</span>\r\n            </a>\r\n        </div>\r\n        <div class=\"modal-body\">\r\n            <div id=\"contact_results\"></div>\r\n            <div class=\"form-inner\">\r\n                <div class=\"description\">{{theme_settings.themevale_ask_an_expert-popupdesc1}}<br>{{theme_settings.themevale_ask_an_expert-popupdesc2}}</div>\r\n                <div class=\"question\">{{theme_settings.themevale_ask_an_expert-popuptext}}</div>\r\n                <form class=\"form\" id=\"contact_form\">\r\n                    <fieldset class=\"form-fieldset\">\r\n                        <div class=\"form-field\">\r\n                            <input required=\"true\" type=\"text\" class=\"form-input\" name=\"customer_name\" placeholder=\"Your Name\" value=\"{{customer.name}}\">\r\n                        </div>\r\n                        <div class=\"form-field\">\r\n                            <input required=\"true\" type=\"text\" class=\"form-input\" name=\"customer_email\" placeholder=\"Email Address\" value=\"{{customer.email}}\">\r\n                        </div>\r\n                        <div class=\"form-field\">\r\n                            <input required=\"true\" type=\"text\" class=\"form-input\" name=\"customer_phone\" placeholder=\"Phone Number\" value=\"{{customer.phone}}\">\r\n                        </div>\r\n                        <div class=\"form-field form-field-radio\">\r\n                            <label class=\"form-label\">Do you need:</label>\r\n                            <input class=\"form-radio\" id=\"pricing-radio\" type=\"radio\" name=\"type_package\" checked value=\"Pricing\">\r\n                            <label class=\"form-label\" for=\"pricing-radio\">Pricing</label>\r\n                            <input class=\"form-radio\" id=\"answers-radio\" type=\"radio\" name=\"type_package\" value=\"Answers\">\r\n                            <label class=\"form-label\" for=\"answers-radio\">Answers</label>\r\n                            <input class=\"form-radio\" id=\"both-radio\" type=\"radio\" name=\"type_package\" value=\"Pricing & Answers\">\r\n                            <label class=\"form-label\" for=\"both-radio\">Both</label>\r\n                        </div>\r\n                        <div class=\"form-field\">\r\n                            <label class=\"form-label\" for=\"comment-area\">What can i help you with today ?</label>\r\n                            <textarea name=\"message\" cols=\"30\" rows=\"6\" class=\"form-input\" id=\"comment-area\" required=\"true\"></textarea>\r\n                        </div>\r\n                        <div class=\"form-field form-field-radio\">\r\n                            <label class=\"form-label form-label-custom\">How would you like me to contact you ?</label>\r\n                            <input class=\"form-radio\" id=\"phone-radio\" type=\"radio\" name=\"type_contact\" checked value=\"Phone\">\r\n                            <label class=\"form-label\" for=\"phone-radio\">Phone</label>\r\n                            <input class=\"form-radio\" id=\"email-radio\" type=\"radio\" name=\"type_contact\" value=\"Email\">\r\n                            <label class=\"form-label\" for=\"email-radio\">Email</label>\r\n                            <input class=\"form-radio\" id=\"both-radio-2\" type=\"radio\" name=\"type_contact\" value=\"Phone & Email\">\r\n                            <label class=\"form-label\" for=\"both-radio-2\">Both</label>\r\n                        </div>\r\n                        <div class=\"form-actions\">\r\n                           <button type=\"button\" class=\"button\" id=\"ask-an-expert-button\">{{theme_settings.themevale_ask_an_expert-popupbtn}}</button>\r\n                        </div>\r\n                    </fieldset>\r\n                </form>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"//ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js\"></script>\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function() {\r\n        $(\"#ask-an-expert-button\").click(function() {\r\n\r\n            var ask_proceed = true;\r\n            //simple validation at client's end\r\n            //loop through each field and we simply change border color to red for invalid fields\r\n            $(\"#contact_form input[required=true], #contact_form textarea[required=true]\").each(function() {\r\n                if (!$.trim($(this).val())) { //if this field is empty\r\n                    $(this).parent('.form-field').removeClass('form-field--success').addClass('form-field--error');\r\n                    ask_proceed = false; //set do not proceed flag\r\n                } else {\r\n                    $(this).parent('.form-field').removeClass('form-field--error').addClass('form-field--success');\r\n                }\r\n                //check invalid email\r\n                var email_reg = /^([\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4})?$/;\r\n                if ($(this).attr(\"name\") == \"customer_email\" && !email_reg.test($.trim($(this).val()))) {\r\n                    $(this).parent('.form-field').removeClass('form-field--success').addClass('form-field--error');\r\n                    ask_proceed = false; //set do not proceed flag\r\n                }\r\n            });\r\n\r\n            if (ask_proceed) //everything looks good! proceed...\r\n            {\r\n                //get input field values data to be sent to server\r\n                ask_post_data = {\r\n                    'api': 'i_send_mail',\r\n                    'subject': '{{theme_settings.themevale_ask_an_expert-popupsubject}}',\r\n                    'from_name': '{{theme_settings.themevale_ask_an_expert-popuplabelname}}',\r\n                    'email': '{{theme_settings.themevale_ask_an_expert-popupmail}}',\r\n                    'email_from': $('#contact_form input[name=customer_email]').val(),\r\n                    'message': '<h2>{{theme_settings.themevale_ask_an_expert-popupsubject}}</h2><table>\\\r\n                            <tr><td><strong>Your Name</strong></td><td>' + $('#contact_form input[name=customer_name]').val() + '</td></tr>\\\r\n                            <tr><td><strong>Email Address</strong></td><td>' + $('#contact_form input[name=customer_email]').val() + '</td></tr>\\\r\n                            <tr><td><strong>Phone Number</strong></td><td>' + $('#contact_form input[name=customer_phone]').val() + '</td></tr>\\\r\n                            <tr><td><strong>How would you like me to contact you ?</strong></td><td>' + $('#contact_form input[name=type_contact]:checked').val() + '</td></tr>\\\r\n                            <tr><td><strong>Do you need</strong></td><td>' + $('#contact_form input[name=type_package]:checked').val() + '</td></tr>\\\r\n                            <tr><td><strong>What can i help you with today ?</strong></td><td>' + $('#contact_form textarea[name=message]').val() + '</td></tr>\\\r\n                        </table>'\r\n                };\r\n\r\n                //Ajax post data to server\r\n                $.post('https://themevale.net/tools/sendmail/ask-an-expert/', ask_post_data, function(response) {\r\n                    if (response.type == 'error') { //load json data from server and output message\r\n                        output = '<div class=\"error\">' + response.text + '</div>';\r\n                    } else {\r\n                        output = '<div class=\"alert alert-success\">Thank you. We\\'ve received your feedback and will respond shortly.</div>';\r\n                        //reset values in all input fields\r\n                        $(\"#contact_form  input[required=true], #contact_form textarea[required=true]\").val('');\r\n                        $(\".form-inner\").hide(); //hide form after success\r\n                    }\r\n                    $(\"#contact_results\").hide().html(output).show();\r\n                }, 'json');\r\n            }\r\n        });\r\n\r\n        //reset previously set border colors and hide all message on .keyup()\r\n        $(\"#contact_form input[required=true], #contact_form textarea[required=true]\").keyup(function() {\r\n            if (!$.trim($(this).val())) { //if this field is empty\r\n                $(this).parent('.form-field').removeClass('form-field--success').addClass('form-field--error');\r\n                ask_proceed = false; //set do not proceed flag\r\n            } else {\r\n                $(this).parent('.form-field').removeClass('form-field--error').addClass('form-field--success');\r\n            }\r\n            //check invalid email\r\n            var email_reg = /^([\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4})?$/;\r\n            if ($(this).attr(\"name\") == \"customer_email\" && !email_reg.test($.trim($(this).val()))) {\r\n                $(this).parent('.form-field').removeClass('form-field--success').addClass('form-field--error');\r\n                ask_proceed = false; //set do not proceed flag\r\n            }\r\n            $(\"#contact_results\").hide();\r\n        });\r\n    });\r\n</script>\r\n"
}
