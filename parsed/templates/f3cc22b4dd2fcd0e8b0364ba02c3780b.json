{"components/cavio/featured-categories":"<div class=\"featured-categories hide-pagination\">\n    <div class=\"featured-category-title\">\n        <h2 class=\"hp-section-title\">{{theme_settings.featured_title}}</h2>\n        <p class=\"hp-section-description\">{{theme_settings.featured_subtext}}</p>\n    </div>\n    <div class=\"featuredcat-nav\">\n        <div class=\"slider-info\">\n          <span class=\"current-slide\"> </span> / <span class=\"total-slides\"> </span>\n        </div>\n        <div class=\"slider-arrows\">\n            <button type=\"button\" aria-label=\"Previous Slide\" class=\"slick-prev\"><svg><use href=\"#icon-cavio_angle-left\"></use></svg></button>\n            <button type=\"button\" aria-label=\"Next Slide\" class=\"slick-next\"><svg><use href=\"#icon-cavio_angle-right\"></use></svg></button>\n        </div> \n    </div>    \n    <div class=\"featured-category-list\">\n        {{#each (split theme_settings.featured_category_ids ',')}}\n        <div class=\"featured-category\" data-category-id=\"{{this}}\">\n            <a class=\"category-link\">\n                <div class=\"thumb-img-category\">\n                    <img src=\"\" class=\"category-image\">\n                </div>\n                <h4 class=\"category-title\"></h4>\n                <div class=\"category-description\"></div>\n            </a>            \n        </div>\n        {{/each}}\n    </div>\n</div>\n"}
