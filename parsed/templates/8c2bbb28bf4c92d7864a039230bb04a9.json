{"components/common/subscription-form":"<div class=\"newsletter-info\">\r\n    <h3 class=\"footer-info-heading\">{{lang 'newsletter.subscribe'}}</h3>\r\n</div>\r\n<div style=\"margin: -4px auto 20px 0;\">\r\n    <img src=\"https://cdn11.bigcommerce.com/s-rryv6w8sxg/images/stencil/original/strider-bikes-logo_1766099428__20429.original.png\" alt=\"Strider footer logo\">\r\n</div>\r\n\r\n<div class=\"form-field\" style=\"width:100%;\">\r\n    <input id=\"subBtn\" class=\"button--signup form-prefixPostfix-button--postfix\"\r\n        style=\"width:100%;max-width:210px;margin-left:0;\"\r\n        type=\"button\"\r\n        value=\"{{lang 'newsletter.subscribe_submit'}}\"\r\n    >\r\n</div>\r\n\r\n{{!-- <form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\r\n    <fieldset class=\"form-fieldset\">\r\n        <input type=\"hidden\" name=\"action\" value=\"subscribe\">\r\n        <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\r\n        <input type=\"hidden\" name=\"check\" value=\"1\">\r\n        <div class=\"form-field\">\r\n            <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\r\n            <div class=\"form-prefixPostfix wrap\">\r\n                <input class=\"form-input\"\r\n                       id=\"nl_email\"\r\n                       name=\"nl_email\"\r\n                       type=\"email\"\r\n                       value=\"{{customer.email}}\"\r\n                       placeholder=\"{{lang 'newsletter.email_placeholder'}}\"\r\n                       aria-describedby=\"alertBox-message-text\"\r\n                       aria-required=\"true\"\r\n                       autocomplete=\"email\"\r\n                       required\r\n                >\r\n                <input class=\"button--signup form-prefixPostfix-button--postfix\"\r\n                       type=\"submit\"\r\n                       value=\"{{lang 'newsletter.subscribe_submit'}}\"\r\n                >\r\n            </div>\r\n            {{#if settings.show_newsletter_summary }}\r\n                <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\r\n            {{/if}}\r\n        </div>\r\n    </fieldset>\r\n</form> --}}\r\n<div class=\"newsletter-info\" style=\"margin-top:15px;margin-bottom:-15px;\">\r\n    <p>{{lang 'newsletter.subscribe_intro'}}</p>\r\n</div> \r\n"}
